---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import Accordion from '../components/Accordion.astro';
import { productBySlug, productUrl } from '../data/products';
import { SITE, messengerUrl } from '../data/site';
import { ornamentG } from '../lib/ornament-svg';

const ng = [
  'privezak-deda-mraz', 'patuljak-sa-led-svecicom', 'mini-jelka-za-sto',
  'prstenovi-za-salvete-set-od-6', 'zlatna-jelka-za-sklapanje', 'ukras-za-jelku-sa-imenom',
  'privezak-irvas', 'jelkica-za-punjenje', 'porodicni-set-ukrasa-sa-imenima',
].map((s) => productBySlug(s)!);

const hang = [
  { x: 110, hy: 180, rot: -3, s: 0.84, motif: 'planine', color: 'zelena', nameColor: 'ista', fb: 'Luka', key: 'a', cls: 'sway sway-1' },
  { x: 530, hy: 225, rot: 3, s: 0.84, motif: 'masna', color: 'crvena', nameColor: 'ista', fb: 'Mila', key: 'c', cls: 'sway sway-3' },
  { x: 330, hy: 110, rot: 0, s: 1.12, motif: 'zvezde', color: 'bela', nameColor: 'crvena', fb: 'Sofija', key: 'b', cls: 'sway' },
];
const hy = (m: string) => (m === 'masna' ? 71 : 64);

const prednosti = [
  { icon: 'cash', title: 'Plaćanje pouzećem', text: 'Plaćate kuriru kad paket stigne.' },
  { icon: 'truck', title: 'Dostava širom Srbije', text: 'Kurirom za 1–2 radna dana.' },
  { icon: 'star', title: 'Izrada po meri', text: 'Ime, mera ili boja: 3–5 radnih dana.' },
  { icon: 'shield', title: 'Proveravamo svako ime', text: 'Pre štampe, a ako nešto nije jasno, pišemo vam.' },
];

const faq = [
  { q: 'Kako se poručuje?', a: 'Izaberite proizvod i kliknite „Poruči preko Messengera”. Poruka sa nazivom i šifrom proizvoda se složi sama, a vi je samo pošaljete. Odgovaramo sa cenom i rokom. <a href="/pomoc/#kako-poruciti">Više u Pomoći</a>' },
  { q: 'Kako se plaća?', a: 'Pouzećem, kuriru kad paket stigne. Kartica i nalog nisu potrebni. <a href="/pomoc/#placanje">Više u Pomoći</a>' },
  { q: 'Kada stiže?', a: 'Proizvodi sa imenom se prave 3–5 radnih dana, a kurir nosi 1–2 radna dana. Za ostale proizvode rok javljamo u poruci. <a href="/pomoc/#rokovi">Više u Pomoći</a>' },
  { q: 'Mogu li ime da napišem ćirilicom?', a: 'Možete. Štampamo tačno kako upišete, latinicom ili ćirilicom.' },
  { q: 'Mogu li da pošaljem poklon na drugu adresu?', a: 'Možete, ali primalac plaća kuriru, jer je plaćanje pouzećem.' },
  { q: 'Mogu li da vratim proizvod?', a: 'Proizvode bez imena u roku od 14 dana od prijema. Proizvode sa imenom samo zbog greške ili oštećenja. <a href="/pomoc/#reklamacije-i-povracaj">Više u Pomoći</a>' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })) };

const patuljak = productBySlug('patuljak-sa-led-svecicom')!;
---
<Base
  title="Ukrasi za jelku sa imenom i pokloni po meri | Bumbaru"
  description="Ukrasi za jelku sa imenom, novogodišnji privesci, patuljak sa LED svećicom i dekoracija za praznični sto. 3D štampa iz Leskovca, poručivanje preko Messengera, dostava širom Srbije."
  image="/img/og/bumbaru.jpg"
  current=""
  jsonld={[faqLd]}
  ornaments
>
  <div class="paper-zone">
    <!-- Vrh: sezona -->
    <section class="wrap hero-sec" aria-labelledby="hero-title">
      <div class="hero">
        <div class="hero-media">
        <picture class="hero-bg">
          <source media="(min-width: 901px)" srcset="/img/bg/hero-nova-godina.webp" />
          <img src="/img/bg/hero-nova-godina-tel.webp" alt="" width="1000" height="562" fetchpriority="high" />
        </picture>
        <div class="hero-stage">
          <svg class="hero-trail" aria-hidden="true" width="300" height="240" viewBox="0 0 300 240">
            <defs><mask id="trailMask" maskUnits="userSpaceOnUse" x="0" y="0" width="300" height="240"><path class="fx-trail" pathLength="100" d="M8 232 C40 130 120 160 160 100 S 250 30 292 40" fill="none" stroke="#fff" stroke-width="14" stroke-linecap="round" /></mask></defs>
            <path d="M8 232 C40 130 120 160 160 100 S 250 30 292 40" fill="none" stroke="#312018" stroke-width="5" stroke-linecap="round" stroke-dasharray="0 12" mask="url(#trailMask)" />
          </svg>
          <span class="hero-bee fx-bee"><img class="fx-float" src="/img/brand/pcelica.webp" alt="" width="320" height="320" /></span>
          <a class="float-card fx-drop" style="--d:0;--r:-3deg" href={productUrl(patuljak.slug)}>
            <span class="fc-img" style="aspect-ratio:5/6"><img src={`${patuljak.images[0].src}-sm.webp`} alt={patuljak.images[0].alt} width="640" height="768" /></span>
            <span class="fc-label">Patuljak sa LED svećicom</span>
          </a>
          <a class="float-card fc-2 fx-drop" style="--d:1;--r:3deg" href="/katalog/nova-godina/?filter=privesci">
            <span class="fc-img" style="aspect-ratio:1/1"><img src="/img/c/privesci-zbirno-sm.webp" alt="Novogodišnji privesci: irvas, jelka, Deda Mraz i Sneško" width="640" height="640" /></span>
            <span class="fc-label">Novogodišnji privesci</span>
          </a>
        </div>
        </div>
        <div class="hero-intro">
          <span class="badge badge-honey fx-rise" style="--d:0">Novogodišnji katalog</span>
          <h1 id="hero-title" class="display fx-rise" style="--d:1">Ukrasi za jelku sa imenom</h1>
          <p class="lead fx-rise" style="--d:2">Upišite ime, izaberite motiv i boju i odmah vidite kako ukras izgleda. U katalogu su i privesci, patuljak sa LED svećicom i dekoracija za praznični sto.</p>
        </div>
        <div class="hero-cta">
          <dl class="facts fx-rise" style="--d:3">
            <div><dt>Ukras sa imenom</dt><dd>4 motiva, 4 boje</dd></div>
            <div><dt>Porodični set</dt><dd>4–5 imena u kutiji</dd></div>
          </dl>
          <div class="btns fx-rise" style="--d:4">
            <a class="btn btn-primary btn-lg" href="/proizvod/ukras-za-jelku-sa-imenom/">Upišite ime</a>
            <a class="btn btn-paper btn-lg" href="/katalog/nova-godina/">Pogledajte katalog</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Novogodišnji katalog -->
    <section class="wrap section" aria-labelledby="ng-title">
      <div class="sec-head">
        <div>
          <h2 id="ng-title" class="h2">Novogodišnji katalog</h2>
          <p>Ukrasi, privesci i dekoracija za praznični sto.</p>
        </div>
        <a class="link-arrow" href="/katalog/nova-godina/">Ceo novogodišnji katalog<Icon name="arrow" /></a>
      </div>
      <div class="grid grid-3 rail-mobile">
        {ng.map((p, i) => <ProductCard p={p} eager={i < 3} />)}
      </div>
    </section>

    <!-- Vaše ime na ukrasu -->
    <section class="wrap section reveal" aria-labelledby="ukras-title">
      <div class="ukr-panel">
        <img class="ukr-bg" src="/img/bg/ukras-pozadina.webp" alt="" width="1000" height="750" loading="lazy" />
        <div class="ukr-text">
          <span class="badge">Po meri</span>
          <h2 id="ukras-title" class="h1">Vaše ime na ukrasu za jelku</h2>
          <p class="lead" style="color:var(--ink)">Upišite ime i odmah vidite kako izgleda na ukrasu. Četiri motiva, u jednoj ili dve boje, latinicom ili ćirilicom.</p>
          <form class="ukr-form" action="/proizvod/ukras-za-jelku-sa-imenom/" method="get">
            <div class="field">
              <label for="home-ime">Ime na ukrasu</label>
              <input id="home-ime" class="input" name="ime" maxlength="12" placeholder="npr. Mila ili Љубица" autocomplete="off" data-home-ime />
            </div>
            <button class="btn btn-primary btn-lg" type="submit">Prikaži na ukrasu</button>
          </form>
          <p class="small muted">Do 12 slova. Sa imenom primamo do 16. 12.</p>
        </div>
        <div class="ukr-stage" role="img" aria-label="Tri ukrasa za jelku sa imenima: zeleni sa planinama, beli sa zvezdama i crveni sa mašnom">
          {hang.map((h) => (
            <div class={`ukr-layer ${h.cls}`} style={`transform-origin:${(h.x / 620 * 100).toFixed(2)}% 0`}>
              <svg viewBox="0 0 620 560" aria-hidden="true">
                <line x1={h.x} y1="0" x2={h.x} y2={h.hy} stroke="#8E2A22" stroke-width={h.s > 1 ? 2 : 1.5} />
                <g transform={`translate(${h.x} ${h.hy}) rotate(${h.rot}) scale(${h.s}) translate(-120 -${hy(h.motif)})`} filter="url(#orn-sh)" set:html={ornamentG({ motif: h.motif, color: h.color, nameColor: h.nameColor, fallback: h.fb, key: h.key })} />
              </svg>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Prednosti -->
    <section class="wrap section-sm" aria-label="Zašto Bumbaru">
      <ul class="trust">
        {prednosti.map((x) => (
          <li><span class="ti"><Icon name={x.icon} size={22} /></span><span><strong>{x.title}</strong><span class="small muted">{x.text}</span></span></li>
        ))}
      </ul>
    </section>
  </div>

  <!-- Stalna ponuda -->
  <section class="wrap section" aria-labelledby="stalna-title">
    <div class="sec-head">
      <div>
        <h2 id="stalna-title" class="h1">Stalna ponuda</h2>
        <p>Pravimo ih cele godine: poklone i priveske sa imenom po vašem imenu, a delove za radionicu i auto po vašem alatu i meri.</p>
      </div>
      <a class="link-arrow" href="/katalog/">Ceo katalog<Icon name="arrow" /></a>
    </div>
    <div class="cats">
      <article class="cat cat-big">
        <div class="cat-media" style="background-image:url(/img/bg/kraft.webp)">
          <span class="cat-icon"><Icon name="gift" size={22} /></span>
          <a class="polaroid" style="--r:-4deg;left:6%;top:20%" href="/proizvod/ukras-za-jelku-sa-imenom/"><img src="/img/c/ukras-sofija-sm.webp" alt="" width="640" height="640" loading="lazy" /><span>Sofija · bela</span></a>
          <a class="polaroid pol-lg" style="--r:2deg;left:33%;top:32%" href="/proizvod/porodicni-set-ukrasa-sa-imenima/"><img src="/img/c/ukras-set-sm.webp" alt="" width="640" height="640" loading="lazy" /><span>Porodični set</span></a>
          <a class="polaroid" style="--r:4deg;right:6%;top:16%" href="/proizvod/ukras-za-jelku-sa-imenom/"><img src="/img/c/ukras-luka-sm.webp" alt="" width="640" height="640" loading="lazy" /><span>Luka · zelena</span></a>
        </div>
        <div class="cat-body">
          <span class="badge badge-custom">Po meri · 3–5 dana</span>
          <h3 class="h2">Pokloni sa imenom</h3>
          <p class="muted">Ime upišete latinicom ili ćirilicom i odmah vidite kako izgleda. Pre štampe proveravamo svako ime.</p>
          <ul class="cat-list">
            <li><a href="/proizvod/ukras-za-jelku-sa-imenom/"><span><strong>Ukras za jelku sa imenom</strong><span class="small muted">4 motiva, 4 boje</span></span><Icon name="arrow" /></a></li>
            <li><a href="/proizvod/porodicni-set-ukrasa-sa-imenima/"><span><strong>Porodični set ukrasa sa imenima</strong><span class="small muted">4 ili 5 imena u jednoj kutiji</span></span><Icon name="arrow" /></a></li>
            <li><a href="/proizvod/porodicni-privezak-sa-imenima/"><span><strong>Porodični set privezaka sa imenima</strong><span class="small muted">2 do 8 imena, 5 stilova slova</span></span><Icon name="arrow" /></a></li>
          </ul>
          <div class="cat-actions">
            <a class="btn btn-primary btn-lg" href="/proizvod/ukras-za-jelku-sa-imenom/">Upišite ime</a>
            <a class="link-arrow" href="/katalog/pokloni-sa-imenom/">Svi pokloni sa imenom<Icon name="arrow" /></a>
          </div>
        </div>
      </article>

      <article class="cat cat-row">
        <div class="cat-media" style="background-image:url(/img/bg/radionica.webp)"><span class="cat-icon"><Icon name="tool" size={22} /></span></div>
        <div class="cat-body">
          <span class="badge badge-leaf">PETG · po meri</span>
          <h3 class="h3">Radionica</h3>
          <p class="small muted">Alat visi na zidu, a baterije stoje pored njega. Za drugi brend pravimo držač po meri.</p>
          <ul class="cat-list">
            <li><a href="/proizvod/drzac-za-aku-alat-parkside-x20v/"><span><strong>Držači za Parkside X20 V</strong><span class="small muted">2 za alat, 2 za baterije</span></span><Icon name="arrow" /></a></li>
            <li><a href="/proizvod/zidni-drzac-za-bateriju/"><span><strong>Zidni držač za bateriju</strong><span class="small muted">Za vaš model, i drugi brendovi</span></span><Icon name="arrow" /></a></li>
          </ul>
          <a class="link-arrow" href="/katalog/radionica/">Sve za radionicu<Icon name="arrow" /></a>
        </div>
      </article>

      <article class="cat cat-row">
        <div class="cat-media" style="background-image:url(/img/bg/auto-moto.webp)"><span class="cat-icon"><Icon name="car" size={22} /></span></div>
        <div class="cat-body">
          <span class="badge badge-leaf">Za auto i motor</span>
          <h3 class="h3">Auto i moto</h3>
          <p class="small muted">Tablica bez rama oko slova, nalepnica koja ostaje na mestu i sitnice za održavanje motora.</p>
          <ul class="cat-list">
            <li><a href="/proizvod/drzac-tablice-bez-okvira/"><span><strong>Držač tablice bez okvira</strong><span class="small muted">Par, bez bušenja</span></span><Icon name="arrow" /></a></li>
            <li><a href="/proizvod/nosac-registracione-nalepnice-za-motor/"><span><strong>Nosač nalepnice za motor</strong><span class="small muted">Za motor, skuter i kvad</span></span><Icon name="arrow" /></a></li>
          </ul>
          <a class="link-arrow" href="/katalog/auto-i-moto/">Sve za auto i motor<Icon name="arrow" /></a>
        </div>
      </article>

      <article class="cat cat-row cat-wing">
        <div class="cat-media cat-pol">
          <span class="cat-icon"><Icon name="key" size={22} /></span>
          <a class="polaroid pol-sm pa" style="--r:-5deg" href="/proizvod/porodicni-privezak-sa-imenima/"><img src="/img/p/porodicni-privezak-sa-imenima/1-sq.webp" alt="" width="900" height="900" loading="lazy" /><span>Sa imenima</span></a>
          <a class="polaroid pol-sm pb" style="--r:4deg" href="/proizvod/privezak-sa-imenom-kockice/"><img src="/img/p/privezak-sa-imenom-kockice/1-sq.webp" alt="" width="900" height="900" loading="lazy" /><span>Kockice</span></a>
        </div>
        <div class="cat-body">
          <span class="badge badge-custom">Sa imenom ili bez</span>
          <h3 class="h3">Privesci</h3>
          <p class="small muted">Mali poklon koji se nosi svaki dan: ime u stilu koji izaberete i bojama koje volite.</p>
          <ul class="cat-list">
            <li><a href="/proizvod/privezak-sa-imenom/"><span><strong>Privezak sa imenom</strong><span class="small muted">Pisana ili štampana slova, vaše boje</span></span><Icon name="arrow" /></a></li>
            <li><a href="/proizvod/privezak-sa-imenom-kockice/"><span><strong>Slova kao od kockica</strong><span class="small muted">I bajkovita ili pikselasta slova</span></span><Icon name="arrow" /></a></li>
            <li><a href="/proizvod/porodicni-privezak-sa-imenima/"><span><strong>Porodični set privezaka</strong><span class="small muted">2 do 8 imena, 5 stilova slova</span></span><Icon name="arrow" /></a></li>
          </ul>
          <a class="link-arrow" href="/katalog/privesci/">Svi privesci<Icon name="arrow" /></a>
        </div>
      </article>

      <article class="cat cat-row cat-honey">
        <div class="cat-media cat-toys"><span class="cat-icon"><Icon name="blocks" size={22} /></span><img src="/img/c/igracke-sm.webp" alt="" width="600" height="600" loading="lazy" /></div>
        <div class="cat-body">
          <span class="badge badge-berry">Uskoro</span>
          <h3 class="h3">Igračke za decu</h3>
          <p class="small muted">Prve igračke od 3D štampe stižu uskoro. Javite nam šta vaše dete voli, pa vam pišemo kad krenu.</p>
          <a class="btn" href={messengerUrl('Zdravo, javite mi kad stignu igračke za decu.', 'igracke')} target="_blank" rel="noopener"><Icon name="messenger" />Javite mi na Messenger-u</a>
          <a class="link-arrow" href="/katalog/pokloni-sa-imenom/">Do tada: pokloni sa imenom<Icon name="arrow" /></a>
        </div>
      </article>
    </div>
  </section>

  <!-- Po meri -->
  <section class="wrap section reveal" aria-labelledby="pomeri-title">
    <div class="pomeri dark">
      <img src="/img/bg/po-meri.webp" alt="3D štampač u radionici sa odštampanim delovima" width="1000" height="750" loading="lazy" />
      <div class="pomeri-text">
        <span class="label" style="color:var(--honey)">3D štampa po meri</span>
        <h2 id="pomeri-title" class="h1">Treba vam deo po meri?</h2>
        <p class="lead" style="color:var(--cream-muted)">Pošaljite meru, skicu ili fotografiju dela koji vam treba. Javljamo cenu i rok izrade, a gotov deo šaljemo kurirom.</p>
        <ul class="checks">
          <li><span><Icon name="check" size={14} stroke={3.2} /></span>Deo koji je pukao ili se više ne prodaje</li>
          <li><span><Icon name="check" size={14} stroke={3.2} /></span>Držač za alat drugog brenda</li>
          <li><span><Icon name="check" size={14} stroke={3.2} /></span>Poklon sa imenom kog nema u katalogu</li>
        </ul>
        <div><a class="btn btn-primary btn-lg" href="/po-meri/">Pošaljite upit</a></div>
        <p class="small" style="color:var(--cream-muted)">Upit je besplatan. Ne plaćate ništa do potvrde cene i roka.</p>
      </div>
    </div>
  </section>

  <!-- Kako poručiti -->
  <section class="wrap section reveal" aria-labelledby="kako-title">
    <div class="kako">
      <div class="sec-head" style="margin-bottom:24px">
        <div><h2 id="kako-title" class="h1">Kako poručiti</h2><p style="color:var(--ink-muted)">Tri koraka i paket je na putu.</p></div>
        <div class="chips"><span class="pill">Bez naloga</span><span class="pill">Preko Messengera</span><span class="pill">Plaćanje pouzećem</span></div>
      </div>
      <ol class="steps">
        <li>
          <div class="step-art art-1">
            <img class="s1a" src="/img/p/patuljak-sa-led-svecicom/1-sq.webp" alt="" width="900" height="900" loading="lazy" />
            <img class="s1b" src="/img/c/ukras-sofija-sm.webp" alt="" width="640" height="640" loading="lazy" />
            <img class="s1c" src="/img/p/mini-jelka-za-sto/1-sq.webp" alt="" width="900" height="900" loading="lazy" />
          </div>
          <div class="step-txt"><span class="num">1</span><div><h3 class="h3">Izaberite proizvod</h3><p class="small muted">Iz kataloga, ili nam pošaljite meru i fotografiju onoga što vam treba.</p></div></div>
        </li>
        <li>
          <div class="step-art art-2">
            <div class="bubble">
              <span class="small muted">Vaša poruka</span>
              <p><strong>Zdravo, želim da poručim:</strong><br />Ukras za jelku sa imenom (NG-01)<br />Ime: Mila</p>
            </div>
            <span class="send"><Icon name="messenger" size={18} />Poruči preko Messengera</span>
          </div>
          <div class="step-txt"><span class="num">2</span><div><h3 class="h3">Pošaljite poruku</h3><p class="small muted">Kliknite „Poruči preko Messengera”: naziv, šifra i link proizvoda su već u poruci.</p></div></div>
        </li>
        <li>
          <div class="step-art art-3">
            <svg viewBox="0 0 300 210" fill="none" aria-hidden="true">
              <path d="M14 112h50M30 136h34M6 160h58" stroke="#335A22" stroke-width="6" stroke-linecap="round" stroke-dasharray="0 13" />
              <path d="M86 78 L176 106 L176 198 L86 170 Z" fill="#C99A5E" />
              <path d="M176 106 L266 78 L266 170 L176 198 Z" fill="#D9B07A" />
              <path d="M86 78 L176 50 L266 78 L176 106 Z" fill="#E6C291" />
              <path d="M122 67 L140 61 L230 89 L212 95 Z" fill="#F5E2A8" />
              <path d="M212 95 L230 89 L230 181 L212 187 Z" fill="#F5E2A8" />
              <path d="M100 120 L150 135 L150 162 L100 147 Z" fill="#EEEAE3" stroke="#312018" stroke-width="2.5" stroke-linejoin="round" />
              <path d="M108 132 L140 142 M108 141 L132 148" stroke="#312018" stroke-width="2.5" stroke-linecap="round" />
              <path d="M86 78 L176 50 L266 78 L266 170 L176 198 L86 170 Z M86 78 L176 106 L266 78 M176 106 L176 198" stroke="#312018" stroke-width="4" stroke-linejoin="round" />
            </svg>
            <img class="s3bee" src="/img/brand/pcelica.webp" alt="" width="320" height="320" loading="lazy" />
            <span class="pay"><Icon name="cash" size={16} stroke={2.2} />Plaćate kuriru</span>
          </div>
          <div class="step-txt"><span class="num">3</span><div><h3 class="h3">Stiže kurirom</h3><p class="small muted">Javljamo cenu i rok, a paket šaljemo kurirom. Plaćate kuriru kad paket stigne.</p></div></div>
