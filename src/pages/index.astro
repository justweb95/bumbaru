</Base>

<script>
  import { fitName } from '../lib/ornament';
  const input = document.querySelector<HTMLInputElement>('[data-home-ime]');
  const fallback: Record<string, string> = { a: 'Luka', b: 'Sofija', c: 'Mila' };
  input?.addEventListener('input', () => {
    document.querySelectorAll<SVGGElement>('.ukr-stage [data-orn]').forEach((g) => {
      const f = fitName(input.value, fallback[g.dataset.orn || 'b']);
      g.querySelectorAll('.orn-name').forEach((t) => { t.textContent = f.name; t.setAttribute('font-size', f.fs); t.setAttribute('y', f.y); });
      g.querySelectorAll('.orn-rail').forEach((r) => { r.setAttribute('d', f.rails); r.setAttribute('stroke-width', f.railW); });
    });
  });
</script>

