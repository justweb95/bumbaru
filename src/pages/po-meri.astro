---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import Accordion from '../components/Accordion.astro';

const faq = [
  { q: 'Koliko košta 3D štampa?', a: 'Zavisi od veličine, materijala i vremena štampe. Tačnu cenu javljamo posle upita, pre izrade.' },
  { q: 'Koliko traje?', a: 'Rok javljamo zajedno sa cenom.' },
  { q: 'Gde je radionica?', a: 'U Leskovcu. Šaljemo kurirom širom Srbije.' },
  { q: 'Da li plaćam nešto pre potvrde?', a: 'Ne. Upit je besplatan, a plaćate pouzećem kad paket stigne.' },
];
---
<Base title="3D štampa po meri: delovi, držači i pokloni | Bumbaru" description="Pošaljite meru, skicu ili fotografiju. Javljamo cenu i rok, a gotov deo šaljemo kurirom širom Srbije. Ne plaćate ništa do potvrde." current="po-meri">
  <div class="wrap">
    <Crumbs items={[{ label: 'Po meri' }]} />
    <section class="pm-hero dark" aria-labelledby="pm-title">
      <div class="pm-text">
        <span class="label" style="color:var(--honey)">Po meri</span>
        <h1 id="pm-title" class="h1">3D štampa po meri</h1>
        <p class="h3" style="font-weight:600">Pošaljite ideju, mi javljamo cenu.</p>
        <p style="color:var(--cream-muted)">Deo koji je pukao, držač za alat, tablica sa prezimenom ili poklon kog nema u katalogu. Pošaljite meru, skicu ili fotografiju.</p>
      </div>
      <img src="/img/bg/po-meri.webp" alt="3D štampač u radionici sa odštampanim delovima" width="1000" height="750" />
    </section>

    <section class="how" aria-labelledby="how-title">
      <h2 id="how-title" class="h2">Kako ide</h2>
      <ol>
        <li><span class="n">1</span><div><strong>Pošaljete upit</strong><p class="small muted">Opišite šta vam treba, pošaljite poruku, a fotografiju ili skicu dodajte u Messenger-u.</p></div></li>
        <li><span class="n">2</span><div><strong>Javljamo cenu i rok</strong><p class="small muted">Do vašeg „da” ništa ne plaćate.</p></div></li>
        <li><span class="n">3</span><div><strong>Štampamo i šaljemo</strong><p class="small muted">Gotov proizvod stiže kurirom, a plaćate pouzećem.</p></div></li>
      </ol>
    </section>

    <div class="pm-grid">
      <section class="panel form-panel" aria-labelledby="upit-title">
        <h2 id="upit-title" class="h2">Upit za izradu</h2>
        <form class="upit" data-upit novalidate>
          <div class="field">
            <label for="u-sta">Šta treba da napravimo?</label>
            <textarea id="u-sta" class="textarea" name="sta" required placeholder="Za šta služi, gde stoji i koliko treba da izdrži."></textarea>
            <p class="hint"><span data-err>Fotografiju ili skicu pošaljite u Messenger-u, odmah posle poruke.</span></p>
          </div>
          <div class="field">
            <label for="u-mere">Mere <span class="opt">(nije obavezno)</span></label>
            <input id="u-mere" class="input" name="mere" placeholder="Dužina, širina i visina, ako ih znate" />
          </div>
          <fieldset class="field">
            <legend class="flabel">Materijal</legend>
            <div class="chips">
              <label class="chip"><input type="radio" name="materijal" value="Ne znam, predložite" checked />Ne znam, predložite</label>
              <label class="chip"><input type="radio" name="materijal" value="PLA" />PLA: ukrasi i pokloni</label>
              <label class="chip"><input type="radio" name="materijal" value="PETG" />PETG: radionica i auto</label>
              <label class="chip"><input type="radio" name="materijal" value="ASA" />ASA: za napolje</label>
            </div>
          </fieldset>
          <div class="two">
            <div class="field">
              <label for="u-kol">Količina <span class="opt">(nije obavezno)</span></label>
              <input id="u-kol" class="input" name="kol" inputmode="numeric" placeholder="npr. 2" />
            </div>
            <div class="field">
              <label for="u-rok">Do kada vam treba? <span class="opt">(nije obavezno)</span></label>
              <input id="u-rok" class="input" name="rok" placeholder="npr. do 15. 12." />
            </div>
          </div>
          <button class="btn btn-primary btn-lg" type="submit"><Icon name="messenger" />Pošaljite upit preko Messengera</button>
          <p class="small muted">Upit je besplatan. Podatke iz upita ne čuvamo na sajtu: poruka ide direktno u naš Messenger.</p>
        </form>
      </section>
      <aside class="side">
        <section class="panel" aria-labelledby="mat-title" style="padding:28px">
          <h2 id="mat-title" class="h3">Od čega štampamo</h2>
          <p class="small muted" style="margin-top:6px">Ako ne znate koji materijal vam treba, izaberite „Ne znam”, pa ćemo predložiti.</p>
          <dl class="mat">
            <div><dt>PLA</dt><dd>Ukrasi, pokloni, natpisi i figure. Lep izgled i mnogo boja, ali ne voli toplotu.</dd></div>
            <div><dt>PETG</dt><dd>Delovi za radionicu i auto koji trpe udarce, vlagu i toplotu.</dd></div>
            <div><dt>ASA</dt><dd>Za napolje: ne bledi na suncu i podnosi kišu i mraz.</dd></div>
          </dl>
        </section>
        <section class="panel" aria-labelledby="ne-title" style="padding:28px;background:var(--berry-soft)">
          <h2 id="ne-title" class="h3">Šta ne štampamo</h2>
          <p class="small" style="margin-top:6px">Delove za kočnice, upravljanje i pojaseve, delove koji nose težinu ljudi, predmete za hranu, oružje i zaštićene likove i logotipe.</p>
        </section>
      </aside>
    </div>

    <section class="section" aria-labelledby="pm-faq">
      <h2 id="pm-faq" class="h2" style="margin-bottom:12px">Česta pitanja</h2>
      <div class="faq-panel"><Accordion items={faq} /></div>
    </section>
  </div>
</Base>
<script>
  const f = document.querySelector<HTMLFormElement>('[data-upit]')!;
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(f);
    const sta = String(d.get('sta') || '').trim();
    const err = f.querySelector<HTMLElement>('[data-err]')!;
    const ta = f.querySelector<HTMLTextAreaElement>('#u-sta')!;
    if (!sta) { ta.focus(); ta.setAttribute('aria-invalid', 'true'); err.textContent = 'Opišite ukratko šta treba da napravimo.'; err.style.color = 'var(--berry)'; return; }
    ta.removeAttribute('aria-invalid');
    const lines = ['Zdravo, imam upit za izradu po meri:', sta];
    const add = (k: string, label: string) => { const v = String(d.get(k) || '').trim(); if (v) lines.push(label + ': ' + v); };
    add('mere', 'Mere'); add('materijal', 'Materijal'); add('kol', 'Količina'); add('rok', 'Rok');
    lines.push('', 'Fotografiju ili skicu šaljem u sledećoj poruci.');
    (window as any).bumbaruMessage(lines.join('\n'), 'po-meri');
  });
</script>
<style>
  .pm-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; background: var(--dark); color: var(--cream); border-radius: var(--r-lg); padding: 24px; }
  .pm-text { display: flex; flex-direction: column; gap: 14px; padding: 24px 24px 24px 32px; }
  .pm-hero img { width: 100%; height: 360px; object-fit: cover; border-radius: 18px; }
  .how { margin-top: 48px; }
  .how ol { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 18px; }
  .how li { display: flex; gap: 14px; align-items: flex-start; padding: 22px; background: var(--surface-paper); border-radius: var(--r-lg); }
  .how .n { flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--honey); border: 2px solid var(--ink); display: inline-flex; align-items: center; justify-content: center; font-weight: 800; }
  .pm-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 24px; margin-top: 48px; align-items: start; }
  .form-panel { padding: 32px; }
  .upit { display: flex; flex-direction: column; gap: 22px; margin-top: 20px; }
  fieldset.field { border: 0; padding: 0; margin: 0; }
  fieldset.field legend { padding: 0; margin-bottom: 8px; }
  .opt { text-transform: none; letter-spacing: 0; font-weight: 400; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .side { display: flex; flex-direction: column; gap: 24px; }
  .mat { margin: 16px 0 0; display: flex; flex-direction: column; gap: 14px; }
  .mat dt { font-weight: 800; }
  .mat dd { margin: 2px 0 0; font-size: 14px; line-height: 20px; color: var(--ink-muted); }
  @media (max-width: 900px) {
    .pm-hero, .pm-grid { grid-template-columns: 1fr; }
    .pm-hero { padding: 16px; } .pm-text { padding: 8px; } .pm-hero img { height: 220px; }
    .how ol { grid-template-columns: 1fr; }
    .form-panel { padding: 22px 18px; }
    .two { grid-template-columns: 1fr; }
  }
</style>
