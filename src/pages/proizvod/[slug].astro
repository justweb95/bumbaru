---
// fontovi za privezke sa imenom (učitavaju se samo slova koja se koriste)
import '@fontsource/playball/400.css';
import '@fontsource/lobster/400.css';
import '@fontsource/mogra/400.css';
import '@fontsource/nunito/900-italic.css';
import '@fontsource/montserrat/800.css';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import Accordion from '../../components/Accordion.astro';
import ColorPicker from '../../components/ColorPicker.astro';
import { PRODUCTS, productBySlug, productUrl, cardImg, type Product } from '../../data/products';
import { categoryBySlug, catUrl } from '../../data/categories';
import { SITE, din, messengerUrl } from '../../data/site';
import { MOTIVI } from '../../lib/ornament';
import { ornamentG } from '../../lib/ornament-svg';
import { BOJE_NA_STANJU, pick } from '../../lib/colors';
import { STILOVI, stil, SLOJ_LABEL, PRIMERI } from '../../lib/keychain';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const cat = categoryBySlug(p.category);
const related = p.related.map((s) => productBySlug(s)).filter(Boolean) as Product[];
const showPrice = SITE.showPrices && p.price;
const priceText = showPrice ? (p.priceFrom ? 'od ' : '') + din(p.price!) + (p.motivi?.lista.length ? ' po komadu' : '') : '';
const isUkras = p.personal === 'ukras';
const isSet = p.personal === 'set';
const isKey = p.personal === 'privezak' && !!p.keychain;
const orn = isUkras || isSet;
const live = orn || isKey;
const ngCustom = p.custom && p.categories.includes('nova-godina');
// Slika za deljenje (Messenger, Facebook): og prve fotografije, inače opšta slika brenda
const og = (p.images[0] || p.motivi?.lista.find((m) => m.slika)?.slika)?.og || '/img/og/bumbaru.jpg';
const ld: any = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.title,
  sku: p.id,
  description: p.lead,
  brand: { '@type': 'Brand', name: 'Bumbaru' },
  image: p.images.map((i) => SITE.url + i.src + '-lg.webp'),
  url: SITE.url + productUrl(p.slug),
};
if (showPrice) ld.offers = { '@type': 'Offer', priceCurrency: 'RSD', price: p.price, availability: 'https://schema.org/InStock', url: SITE.url + productUrl(p.slug) };

// Pregled ukrasa
const S = 1.62, HY = 136;
const setPos = (n: number) => n === 4
  ? { s: 0.92, pts: [[165, 36], [435, 36], [165, 312], [435, 312]] }
  : { s: 0.76, pts: [[108, 44], [300, 44], [492, 44], [204, 318], [396, 318]] };
// „Šareno” za porodični set: boje na stanju, prvo klasične boje ukrasa
const naStanju = BOJE_NA_STANJU.map((b) => b.id);
const sarenoUkrasi = [...['bela', 'crvena', 'zelena', 'zlatna'].filter((id) => naStanju.includes(id)), ...naStanju.filter((id) => !['bela', 'crvena', 'zelena', 'zlatna'].includes(id))];
const SARENO = Array.from({ length: 5 }, (_, i) => sarenoUkrasi[i % Math.max(1, sarenoUkrasi.length)] || 'bela');
const setNames = ['Marko', 'Jelena', 'Luka', 'Mila', 'Ana'];

// Privezak sa imenom
const kc = p.keychain;
const kcStilovi = kc ? kc.stilovi.map((id) => stil(id)) : [];
const kcPrvi = kcStilovi[0];
const kcData = kc ? JSON.stringify({ ...kc, sarenoDefault: kc.startImena > 1 && !!kc.sareno }) : '';

// Izbor motiva (npr. modlice): kupac bira motive i broj komada, popust raste sa brojem komada
const mot = p.motivi && p.motivi.lista.length ? p.motivi : null;
const motSlike = mot ? mot.lista.filter((m) => m.slika) : [];
const motMax = mot && mot.popusti.length ? mot.popusti[mot.popusti.length - 1].od : 0;
const motData = mot ? JSON.stringify({ lista: mot.lista.map((m) => ({ id: m.id, naziv: m.naziv, slika: !!m.slika })), popusti: mot.popusti, cena: showPrice ? p.price : 0 }) : '';
const prvaMotiv = !live && p.images.length === 0 ? motSlike[0] : undefined; // bez galerije: prva fotografija motiva

const askText = `Zdravo, imam pitanje o proizvodu: ${p.title} (šifra ${p.id})\n${SITE.url}${productUrl(p.slug)}`;
const aboutTitle = orn ? (isSet ? 'O setu' : 'O ukrasu') : 'O proizvodu';
// Ikonice za karakteristike i „Dobro je da znate”
const specIcon = (k: string) => {
  const s = k.toLowerCase();
  if (s.startsWith('motiv') || s === 'oblik' || s.startsWith('stil')) return 'star';
  if (s.startsWith('boj')) return 'palette';
  if (s.startsWith('ime')) return 'pen';
  if (s.startsWith('materijal')) return 'layers';
  if (s.startsWith('pakovanje') || s.startsWith('u setu') || s.startsWith('u kompletu') || s.startsWith('u pakovanju')) return 'gift';
  if (s.startsWith('rok')) return 'calendar';
  if (s.startsWith('plaćanje')) return 'cash';
  if (s.startsWith('karika') || s.startsWith('kačenje')) return 'key';
  if (s.startsWith('svetlo')) return 'bulb';
  if (s.startsWith('montaža')) return 'tool';
  if (s.startsWith('sklapanje')) return 'blocks';
  if (s.startsWith('debljin')) return 'ruler';
  return 'check';
};
const detailIcon = (q: string) => {
  const s = q.toLowerCase();
  if (s.startsWith('pakovanje')) return 'gift';
  if (s.startsWith('rok')) return 'truck';
  if (s.startsWith('povraćaj')) return 'shield';
  if (s.startsWith('održavanje')) return 'sparkle';
  if (s.includes('led')) return 'bulb';
  return 'check';
};
---
<Base title={p.seoTitle} description={p.meta} image={og} imageAlt={p.images[0]?.alt || p.title} type="product" current={p.category} jsonld={[ld]} ornaments={orn}>
  <div class="paper-zone pz">
    <div class="wrap">
      <Crumbs items={[{ label: cat.label, href: catUrl(cat.slug) }, { label: p.title }]} />
    </div>
    <div class="wrap pd">
      <!-- Galerija -->
      <div class="gallery" data-gallery>
        <div class="stage">
          {live && (
            <div class="slide live" data-slide="live">
              <span class="badge live-badge"><i class="dotlive"></i>{isKey ? 'Okvirni pregled' : 'Pregled uživo'}</span>
              {isUkras && (
                <div class="sway-box sway">
                  <svg viewBox="0 0 600 600" role="img" aria-label="Pregled ukrasa sa vašim imenom" data-preview="ukras">
                    <line x1="300" y1="0" x2="300" y2={HY} stroke="#8E2A22" stroke-width="2.6" />
                    <g transform={`translate(300 ${HY}) scale(${S}) translate(-120 -64)`} filter="url(#orn-sh)" data-tf set:html={ornamentG({ motif: 'zvezde', color: pick('bela'), nameColor: pick('crvena', 1), fallback: 'Mila', key: 'main' })} />
                  </svg>
                </div>
              )}
              {isSet && [4, 5].map((n) => {
                const L = setPos(n);
                return (
                  <svg viewBox="0 0 600 600" role="img" aria-label={`Pregled porodičnog seta od ${n} ukrasa`} data-preview={`set${n}`} hidden={n === 5}>
                    {L.pts.map(([x, y], i) => (
                      <g transform={`translate(${x} ${y}) scale(${L.s}) translate(-120 -49)`} filter="url(#orn-sh)" set:html={ornamentG({ motif: 'zvezde', color: SARENO[i], nameColor: 'ista', fallback: setNames[i], key: `s${i}` })} />
                    ))}
                  </svg>
                );
              })}
              {isKey && <svg class="kc-svg" viewBox="0 0 600 300" role="img" aria-label="Pregled privezaka sa vašim imenima" data-kc-svg></svg>}
            </div>
          )}
          {p.images.map((im, i) => (
            <div class="slide" data-slide={`i${i}`} hidden={live || i > 0}>
              {im.w !== im.h && <img class="backdrop" src={cardImg(im)} alt="" width="900" height="900" loading="lazy" aria-hidden="true" />}
              <img class="full" src={`${im.src}-lg.webp`} alt={im.alt} width={im.w} height={im.h} loading={i === 0 && !live ? 'eager' : 'lazy'} fetchpriority={i === 0 && !live ? 'high' : undefined} decoding="async" />
            </div>
          ))}
          {motSlike.map((m) => (
            <div class="slide" data-slide={`m-${m.id}`} hidden={m !== prvaMotiv}>
              {m.slika!.w !== m.slika!.h && <img class="backdrop" src={cardImg(m.slika!)} alt="" width="900" height="900" loading="lazy" aria-hidden="true" />}
              <img class="full" src={`${m.slika!.src}-lg.webp`} alt={m.slika!.alt || m.naziv} width={m.slika!.w} height={m.slika!.h} loading={m === prvaMotiv ? 'eager' : 'lazy'} decoding="async" />
              <span class="badge mot-slide-name">{m.naziv}</span>
            </div>
          ))}
          {!live && p.images.length === 0 && !prvaMotiv && (
            <div class="slide"><div class="soon-photo"><img src="/img/brand/pcelica.webp" alt="" width="320" height="320" /><span>Fotografija uskoro</span></div></div>
          )}
        </div>
        {(live ? p.images.length > 0 : p.images.length > 1) && (
          <div class="thumbs" role="group" aria-label="Fotografije">
            {live && <button type="button" class="thumb thumb-live" data-thumb="live" aria-pressed="true" aria-label="Pregled sa vašim imenom"><Icon name="star" size={22} /><span>Pregled</span></button>}
            {p.images.map((im, i) => (
              <button type="button" class="thumb" data-thumb={`i${i}`} aria-pressed={!live && i === 0 ? 'true' : 'false'} aria-label={`Fotografija ${i + 1}: ${im.alt}`}><img src={cardImg(im)} alt="" width="120" height="120" loading="lazy" /></button>
            ))}
          </div>
        )}
        {isKey && (
          <p class="kc-note" role="note"><Icon name="camera" size={20} /><span><strong>Pregled je okviran.</strong> Pokazuje vaša imena i izabrane boje, a pravi izgled priveska vidi se na fotografijama. Oblik slova, debljina i ivice na gotovom privesku mogu da odudaraju od pregleda.</span></p>
        )}
      </div>

      <!-- Podaci i porudžbina -->
      <div class="info">
        <div class="badges">
          {p.custom ? <><span class="badge badge-custom">Po meri</span><span class="badge">Izrada 3–5 radnih dana</span></> : <span class="badge">{cat.label}</span>}
        </div>
        <h1 class="h1">{p.title}</h1>
        {priceText && <p class="price">{priceText}</p>}
        <p class="lead" style="color:var(--ink)">{p.lead}</p>

        <form class="order" id="poruci" data-order-form data-id={p.id} data-personal={p.personal || ''} data-kc={kcData || undefined} novalidate>
          {isUkras && (
            <div class="field">
              <label for="f-ime">Ime na ukrasu</label>
              <input id="f-ime" class="input" name="ime" maxlength="12" placeholder="npr. Mila ili Љубица" autocomplete="off" data-ime required />
              <p class="hint"><span data-err-ime>Latinicom ili ćirilicom. Štampamo tačno kako upišete.</span><span data-cnt>0/12</span></p>
            </div>
          )}

          {isKey && kcStilovi.length > 1 && (
            <fieldset class="field">
              <legend class="flabel">Stil slova</legend>
              <div class="style-grid">
                {kcStilovi.map((st, i) => (
                  <label class="style-tile">
                    <input type="radio" name="stil" value={st.id} checked={i === 0} data-label={st.label} />
                    <img class="style-img" src={`/img/stil/${st.id}.webp`} alt="" width="360" height="180" loading="lazy" />
                    <span class="style-name">{st.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}
          {isKey && kc && (
            <fieldset class="field">
              <legend class="flabel">{kc.maxImena > 1 ? 'Imena (svako ime je jedan privezak)' : 'Ime'}</legend>
              <div class="kc-names" data-kc-names>
                {Array.from({ length: kc.startImena }, (_, i) => (
                  <div class="kc-row" data-kc-row>
                    <label class="sr-only" for={`kc-${i}`}>Ime {i + 1}</label>
                    <input id={`kc-${i}`} class="input" maxlength="12" placeholder={`npr. ${PRIMERI[i % PRIMERI.length]}`} autocomplete="off" data-kc-name />
                    <button type="button" class="icon-btn kc-del" aria-label={`Ukloni ime ${i + 1}`} data-kc-del hidden={i < kc.minImena}><Icon name="close" size={18} /></button>
                  </div>
                ))}
              </div>
              {kc.maxImena > 1 && <button type="button" class="btn btn-sm kc-add" data-kc-add><Icon name="plus" size={18} />Dodajte još jedno ime</button>}
              <p class="hint"><span data-err-names>Do 12 slova po imenu, latinicom ili ćirilicom.</span></p>
            </fieldset>
          )}
          {isKey && kcPrvi && (
            <div class="kc-colors">
              <ColorPicker name="slova" label={SLOJ_LABEL.slova} def={kcPrvi.def.slova} mix={kc!.sareno ? 'Šareno' : undefined} mixDefault={kc!.startImena > 1 && !!kc!.sareno} attrs={{ 'data-layer': 'slova' }} />
              <ColorPicker name="okvir" label={SLOJ_LABEL.okvir} def={kcPrvi.def.okvir} mix={kc!.sareno ? 'Šareno' : undefined} attrs={{ 'data-layer': 'okvir', ...(kcPrvi.slojevi.includes('okvir') ? {} : { hidden: '' }) }} />
              <ColorPicker name="osnova" label={SLOJ_LABEL.osnova} def={kcPrvi.def.osnova} attrs={{ 'data-layer': 'osnova' }} />
              {kc!.sareno && <p class="hint">Šareno: svako ime u drugoj boji.</p>}
            </div>
          )}

          {isSet && (
            <fieldset class="field">
              <legend class="flabel">Broj ukrasa</legend>
              <div class="chips">
                <label class="chip"><input type="radio" name="broj" value="4" checked />4 ukrasa</label>
                <label class="chip"><input type="radio" name="broj" value="5" />5 ukrasa</label>
              </div>
            </fieldset>
          )}
          {isSet && (
            <fieldset class="field">
              <legend class="flabel">Imena</legend>
              <div class="names">
                {Array.from({ length: 5 }, (_, i) => (
                  <div class="name-row" data-name-row={i} hidden={i === 4}>
                    <label class="sr-only" for={`f-n${i}`}>Ime {i + 1}</label>
                    <input id={`f-n${i}`} class="input" name={`ime${i}`} maxlength="12" placeholder={`Ime ${i + 1}`} autocomplete="off" data-set-name={i} />
                  </div>
                ))}
              </div>
              <p class="hint"><span data-err-names>Do 12 slova po imenu, latinicom ili ćirilicom.</span></p>
            </fieldset>
          )}
          {orn && (
            <fieldset class="field">
              <legend class="flabel">{isSet ? 'Motiv za sve ukrase' : 'Motiv'}</legend>
              <div class="tile-grid">
                {MOTIVI.map((m, i) => (
                  <label class="tile">
                    <input type="radio" name="motiv" value={m.id} checked={i === 0} data-label={m.label} />
                    <svg viewBox="0 40 240 250" aria-hidden="true"><use href={`#orn-${m.id}`} fill="#7A6A5A" stroke="#7A6A5A" /></svg>
                    {m.label}
                  </label>
                ))}
              </div>
            </fieldset>
          )}
          {orn && <ColorPicker name="boja" label="Boja ukrasa" def="bela" mix={isSet ? 'Šareno' : undefined} mixDefault={isSet} />}
          {orn && (
            <div>
              <ColorPicker name="bojaImena" label="Boja imena" def="crvena" extra={[{ value: 'ista', label: 'Kao ukras', css: 'linear-gradient(135deg, #EEEAE3 50%, #ADA498 50%)', checked: isSet }]} />
              <p class="hint" style="margin-top:8px">Ime u drugoj boji štampamo u istom komadu, bez lepljenja.</p>
            </div>
          )}

          {mot && (
            <fieldset class="field mot" data-motivi={motData}>
              <legend class="flabel">Izaberite motive</legend>
              <p class="hint mot-hint">Kliknite one koji vam se sviđaju. Može i više komada istog motiva.</p>
              <div class="mot-grid" data-mot-grid>
                {mot.lista.map((m) => (
                  <div class="mot-tile" data-mot={m.id}>
                    <button type="button" class="mot-pick" aria-pressed="false" data-mot-pick aria-label={m.naziv}>
                      <span class="mot-img">{m.slika ? <img src={cardImg(m.slika)} alt="" width="300" height="300" loading="lazy" /> : <img class="mot-ph" src="/img/brand/pcelica.webp" alt="" width="160" height="160" loading="lazy" />}</span>
                      <span class="mot-name">{m.naziv}</span>
                      <span class="mot-check" aria-hidden="true"><Icon name="check" size={14} stroke={3} /></span>
                    </button>
                    <div class="mot-step" data-mot-step hidden>
                      <button type="button" data-mot-dec aria-label={`Jedan manje: ${m.naziv}`}>−</button>
                      <span data-mot-n aria-live="polite">1</span>
                      <button type="button" data-mot-inc aria-label={`Još jedan: ${m.naziv}`}>+</button>
                    </div>
                  </div>
                ))}
              </div>
              {mot.popusti.length > 0 && (
                <div class="mm" aria-hidden="true">
                  <div class="mm-track">
                    <div class="mm-fill" data-mm-fill></div>
                    {mot.popusti.map((x) => (
                      <span class="mm-stop" data-mm-stop={x.od} style={`--x:${(x.od / motMax) * 100}%`}><i></i><span class="mm-lab"><b>−{x.procenat}%</b><small>{x.od} kom</small></span></span>
                    ))}
                    <img class="mm-bee" data-mm-bee src="/img/brand/pcelica.webp" alt="" width="44" height="44" />
                  </div>
                </div>
              )}
              <p class="mm-msg" aria-live="polite"><span class="mm-count" data-mm-count>0 kom</span><span class="mm-badge" data-mm-badge hidden></span><span data-mm-text>{mot.popusti[0] ? `Od ${mot.popusti[0].od} komada dobijate popust ${mot.popusti[0].procenat}%.` : 'Kliknite motive koje želite.'}</span></p>
              {showPrice && <p class="mm-total" data-mm-total hidden></p>}
              <p class="hint mot-err" data-err-mot role="alert"></p>
            </fieldset>
          )}

          {(p.colors || []).map((c) => <ColorPicker name={`c-${c.id}`} label={c.label} def={c.def} attrs={{ 'data-color-choice': c.label }} />)}

          {(p.options || []).map((o) => (
            o.values.length <= 4 ? (
              <fieldset class="field">
                <legend class="flabel">{o.label}</legend>
                <div class="chips">
                  {o.values.map((v, i) => <label class="chip"><input type="radio" name={`o-${o.id}`} value={v} checked={i === 0} data-option={o.label} />{v}</label>)}
                </div>
              </fieldset>
            ) : (
              <div class="field">
                <label for={`o-${o.id}`}>{o.label}</label>
                <select id={`o-${o.id}`} class="select" name={`o-${o.id}`} data-option={o.label}>
                  {o.values.map((v) => <option>{v}</option>)}
                </select>
              </div>
            )
          ))}
          <div class="field">
            <label for="f-nap">Napomena <span style="text-transform:none;letter-spacing:0;font-weight:400">(nije obavezno)</span></label>
            <input id="f-nap" class="input" name="napomena" maxlength="160" placeholder={p.custom ? 'npr. poruka za karticu u paketu' : mot ? 'npr. rok ili poruka za karticu' : 'npr. broj komada, rok'} autocomplete="off" />
          </div>
          <div class="buy">
            {!isKey && !mot && (
              <div class="qty" role="group" aria-label="Količina">
                <button type="button" data-dec aria-label="Smanji količinu">−</button>
                <input type="number" name="kol" value="1" min="1" max="50" inputmode="numeric" aria-label="Količina" />
                <button type="button" data-inc aria-label="Povećaj količinu">+</button>
              </div>
            )}
            <button class="btn btn-primary btn-lg buy-btn" type="submit"><Icon name="messenger" />Poruči preko Messengera</button>
          </div>
          <ul class="notes small">
            {ngCustom && <li><Icon name="calendar" size={18} />Poručite do 16. 12. i stiže pre Nove godine.</li>}
            {isKey && <li><Icon name="camera" size={18} />Pregled je okviran, a pravi izgled priveska je na fotografijama.</li>}
            <li><Icon name="cash" size={18} />Plaćate kuriru kad paket stigne. Cenu i dostavu javljamo u odgovoru.</li>
            <li><Icon name="messenger" size={18} />Poruka se složi sama: naziv, šifra {p.id}, vaš izbor i link proizvoda.</li>
          </ul>
        </form>

        <div class="trail" aria-hidden="true"></div>
        <ul class="perks">
          <li><span class="ti"><Icon name="cash" /></span><span><strong>Plaćanje pouzećem</strong><span class="small muted">Plaćate kuriru kad paket stigne.</span></span></li>
          <li><span class="ti"><Icon name="truck" /></span><span><strong>Dostava širom Srbije</strong><span class="small muted">Kurirom za 1–2 radna dana.</span></span></li>
          {p.custom ? <li><span class="ti"><Icon name="shield" /></span><span><strong>Proveravamo svako ime</strong><span class="small muted">Pre štampe, a ako nešto nije jasno, pišemo vam.</span></span></li>
            : <li><span class="ti"><Icon name="box" /></span><span><strong>Vraćanje 14 dana</strong><span class="small muted">Bez navođenja razloga.</span></span></li>}
        </ul>
        <div class="ask">
          <p class="small muted">Niste sigurni šta da izaberete? Pitajte nas pre porudžbine.</p>
          <a class="btn" href={messengerUrl(askText, p.id)} target="_blank" rel="noopener"><Icon name="messenger" />Pitajte na Messenger-u</a>
        </div>
      </div>
    </div>

    <div class="wrap lower">
      <!-- O proizvodu i karakteristike -->
      <section class="about-grid" aria-labelledby="o-proizvodu">
        <div class="about-card reveal">
          <img class="about-bee fx-float" src="/img/brand/pcelica.webp" alt="" width="320" height="320" loading="lazy" />
          <span class="badge badge-honey">{p.custom ? 'Po meri · 3–5 dana' : cat.label}</span>
          <h2 id="o-proizvodu" class="h1">{aboutTitle}</h2>
          <svg class="draw-trail" viewBox="0 0 260 24" aria-hidden="true">
            <defs><mask id="dtm" maskUnits="userSpaceOnUse" x="0" y="0" width="260" height="24"><path class="dt-m" pathLength="100" d="M4 16 C60 2 110 26 160 12 S 230 4 256 10" fill="none" stroke="#fff" stroke-width="12" stroke-linecap="round" /></mask></defs>
            <path d="M4 16 C60 2 110 26 160 12 S 230 4 256 10" fill="none" stroke="#312018" stroke-width="4.5" stroke-linecap="round" stroke-dasharray="0 11" mask="url(#dtm)" />
          </svg>
          {p.about.map((t) => <p>{t}</p>)}
          <a class="btn btn-primary btn-lg" href="#poruci"><Icon name="messenger" />{p.personal ? 'Upišite ime i poručite' : 'Poručite preko Messengera'}</a>
        </div>
        {p.specs.length > 0 && (
          <div class="specs-wrap">
            <h3 class="label specs-title"><Icon name="sparkle" size={16} />Karakteristike</h3>
            <ul class="spec-grid">
              {p.specs.map(([k, v], i) => (
                <li class={`spec reveal tone-${i % 4}`} style={`--d:${i}`}>
                  <span class="spec-ic"><Icon name={specIcon(k)} size={20} /></span>
                  <span class="spec-k">{k}</span>
                  <span class="spec-v">{v}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <!-- Dobro je da znate -->
      {p.details.length > 0 && (
        <section class="section" aria-labelledby="znate-title">
          <div class="sec-head reveal">
            <div><h2 id="znate-title" class="h1">Dobro je da znate</h2><p>Pakovanje, rokovi i šta ako nešto nije u redu.</p></div>
          </div>
          <ul class="know-grid">
            {p.details.map((d, i) => (
              <li class={`know-card reveal tone-${(i + 1) % 4}`} style={`--d:${i}`}>
                <span class="know-ic"><Icon name={detailIcon(d.q)} size={24} /></span>
                <h3 class="h3">{d.q}</h3>
                <p>{d.a}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Poručivanje u tri koraka -->
      <section class="section" aria-labelledby="kako-p">
        <div class="howto reveal">
          <div class="howto-head">
            <div>
              <span class="label">Bez naloga i bez korpe</span>
              <h2 id="kako-p" class="h1">Poručivanje u tri koraka</h2>
            </div>
            <a class="btn btn-paper btn-lg" href="#poruci"><Icon name="messenger" />Poruči preko Messengera</a>
          </div>
          <ol class="howto-steps">
            <li class="reveal" style="--d:1"><span class="num">1</span><div><strong>{p.personal ? 'Upišite ime i izaberite boje' : mot ? 'Izaberite motive' : p.options ? 'Izaberite šta vam treba' : 'Izaberite količinu'}</strong><p class="small">{orn ? 'Pregled odmah pokazuje kako će izgledati.' : isKey ? 'Okvirni pregled pokazuje vaša imena i boje.' : 'Napomenu možete dodati pre slanja poruke.'}</p></div></li>
            <li class="reveal" style="--d:2"><span class="num">2</span><div><strong>Pošaljite poruku</strong><p class="small">Naziv, šifra {p.id} i link proizvoda su već u poruci.</p></div></li>
            <li class="reveal" style="--d:3"><span class="num">3</span><div><strong>Plaćate kuriru</strong><p class="small">Javljamo cenu i rok, a paket stiže kurirom širom Srbije.</p></div></li>
          </ol>
        </div>
      </section>

      <!-- Česta pitanja -->
      {p.faq.length > 0 && (
        <section class="section" aria-labelledby="faq-p">
          <div class="faq-grid">
            <div class="faq-side reveal">
              <h2 id="faq-p" class="h1">Česta pitanja</h2>
              <p class="muted">O ovom proizvodu, ukratko.</p>
              <div class="help-card">
                <img class="fx-float" src="/img/brand/pcelica.webp" alt="" width="320" height="320" loading="lazy" />
                <h3 class="h3">Imate drugo pitanje?</h3>
                <p class="small">Pišite nam pre porudžbine, odgovaramo u Messenger-u.</p>
                <a class="btn btn-paper" href={messengerUrl(askText, p.id)} target="_blank" rel="noopener"><Icon name="messenger" />Pitajte na Messenger-u</a>
              </div>
            </div>
            <div class="faq-box reveal" style="--d:1"><Accordion items={p.faq} open={0} /></div>
          </div>
        </section>
      )}

      <!-- Preporuke -->
      {related.length > 0 && (
        <section class="section" aria-labelledby="rel-title">
          <div class="sec-head reveal">
            <div class="rel-h">
              <img class="fx-float" src="/img/brand/pcelica.webp" alt="" width="320" height="320" loading="lazy" />
              <div><h2 id="rel-title" class="h1">Uz ovo preporučujemo</h2><p>Proizvodi koji lepo idu uz ovaj.</p></div>
            </div>
            <a class="link-arrow" href={catUrl(cat.slug)}>Ceo katalog<Icon name="arrow" /></a>
          </div>
          <div class="grid rail-mobile">
            {related.map((r, i) => <div class="reveal" style={`--d:${i}`}><ProductCard p={r} /></div>)}
          </div>
        </section>
      )}
    </div>
  </div>
</Base>
<script>
  import { fitName, boja, motiv } from '../../lib/ornament';
  import { BOJE_NA_STANJU, SVE_BOJE } from '../../lib/colors';
  import { stil, nacrtaj, ucitajFont, PRIMERI, type Sloj } from '../../lib/keychain';
  const form = document.querySelector<HTMLFormElement>('[data-order-form]')!;
  const personal = form.dataset.personal || '';
  const id = form.dataset.id || '';

  // Galerija
  const gal = document.querySelector('[data-gallery]');
  gal?.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((b) => b.addEventListener('click', () => {
    const liveSkriven = (gal.querySelector<HTMLElement>('[data-slide="live"]')?.hidden) ?? false;
    gal.querySelectorAll<HTMLElement>('[data-slide]').forEach((s) => { s.hidden = s.dataset.slide !== b.dataset.thumb; });
    gal.querySelectorAll('[data-thumb]').forEach((t) => t.setAttribute('aria-pressed', String(t === b)));
    // privezak se meri tek kad je vidljiv
    if (b.dataset.thumb === 'live' && liveSkriven && kcCfg) drawKc();
  }));
  const showLive = () => (gal?.querySelector('[data-thumb="live"]') as HTMLButtonElement | null)?.click();
  // fotografija motiva u galeriji (bez sličice ispod)
  const showSlide = (key: string) => {
    const t = gal?.querySelector<HTMLElement>(`[data-slide="${key}"]`);
    if (!gal || !t) return;
    gal.querySelectorAll<HTMLElement>('[data-slide]').forEach((s) => { s.hidden = s !== t; });
    gal.querySelectorAll('[data-thumb]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
  };

  // Količina
  const kol = form.querySelector<HTMLInputElement>('input[name="kol"]');
  const clamp = (v: number) => Math.max(1, Math.min(50, v || 1));
  form.querySelector('[data-inc]')?.addEventListener('click', () => { if (kol) kol.value = String(clamp(+kol.value + 1)); });
  form.querySelector('[data-dec]')?.addEventListener('click', () => { if (kol) kol.value = String(clamp(+kol.value - 1)); });

  const val = (name: string) => (form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value) || '';
  const lab = (name: string) => (form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.dataset.label) || '';
  const hex = (cid: string) => (SVE_BOJE.find((b) => b.id === cid) || SVE_BOJE[0]).hex;
  const naziv = (cid: string) => (SVE_BOJE.find((b) => b.id === cid) || { naziv: cid }).naziv;

  // ——— Ukras sa imenom i porodični set ———
  function paint(g: Element, o: { motif: string; color: string; nameColor: string; name: string; fallback: string }) {
    const M = motiv(o.motif), B = boja(o.color), N = o.nameColor === 'ista' ? B : boja(o.nameColor);
    const f = fitName(o.name, o.fallback);
    const e = g.querySelector('.orn-edge')!, fc = g.querySelector('.orn-face')!;
    [e, fc].forEach((u) => u.setAttribute('href', '#orn-' + M.id));
    e.setAttribute('fill', B.edge); e.setAttribute('stroke', B.edge);
    fc.setAttribute('fill', B.face); fc.setAttribute('stroke', B.face);
    const ne = g.querySelector('.orn-ne')!, nf = g.querySelector('.orn-nf')!;
    ne.setAttribute('fill', N.edge); ne.setAttribute('stroke', N.edge);
    nf.setAttribute('fill', N.face); nf.setAttribute('stroke', N.face);
    g.querySelectorAll('.orn-name').forEach((t) => { t.textContent = f.name; t.setAttribute('font-size', f.fs); t.setAttribute('y', f.y); });
    g.querySelectorAll('.orn-rail').forEach((r) => { r.setAttribute('d', f.rails); r.setAttribute('stroke-width', f.railW); });
    return M;
  }
  const naStanju = BOJE_NA_STANJU.map((b) => b.id);
  const klasicne = ['bela', 'crvena', 'zelena', 'zlatna'];
  const sarenoUkrasi = [...klasicne.filter((x) => naStanju.includes(x)), ...naStanju.filter((x) => !klasicne.includes(x))];
  const FALL = ['Marko', 'Jelena', 'Luka', 'Mila', 'Ana'];
  function updateOrn() {
    if (personal === 'ukras') {
      const g = document.querySelector('[data-orn="main"]');
      const ime = form.querySelector<HTMLInputElement>('[data-ime]')!;
      if (g) {
        const M = paint(g, { motif: val('motiv'), color: val('boja'), nameColor: val('bojaImena'), name: ime.value, fallback: 'Mila' });
        g.parentElement?.setAttribute('transform', `translate(300 136) scale(1.62) translate(-120 -${M.hy})`);
      }
      const cnt = form.querySelector('[data-cnt]');
      if (cnt) cnt.textContent = Array.from(ime.value.trim()).length + '/12';
    }
    if (personal === 'set') {
      const n = val('broj') === '5' ? 5 : 4;
      document.querySelectorAll<SVGElement>('[data-preview^="set"]').forEach((s) => { s.toggleAttribute('hidden', s.dataset.preview !== 'set' + n); });
      form.querySelectorAll<HTMLElement>('[data-name-row]').forEach((r) => { r.hidden = Number(r.dataset.nameRow) >= n; });
      const svg = document.querySelector(`[data-preview="set${n}"]`);
      svg?.querySelectorAll('[data-orn]').forEach((g, i) => {
        const inp = form.querySelector<HTMLInputElement>(`[data-set-name="${i}"]`);
        paint(g, { motif: val('motiv'), color: val('boja') === 'sareno' ? sarenoUkrasi[i % sarenoUkrasi.length] : val('boja'), nameColor: val('bojaImena'), name: inp?.value || '', fallback: FALL[i] });
      });
    }
    if (personal === 'ukras' || personal === 'set') {
      const b = val('boja');
      const col = !b || b === 'sareno' || b === 'bela' ? '#7A6A5A' : boja(b).face;
      form.querySelectorAll('.tile use').forEach((u) => { u.setAttribute('fill', col); u.setAttribute('stroke', col); });
    }
  }

  // ——— Privezak sa imenom ———
  const kcCfg = form.dataset.kc ? JSON.parse(form.dataset.kc) : null;
  const kcSvg = document.querySelector<SVGSVGElement>('[data-kc-svg]');
  const kcBox = form.querySelector<HTMLElement>('[data-kc-names]');
  const kcAdd = form.querySelector<HTMLButtonElement>('[data-kc-add]');
  const touched = new Set<string>();
  const kcStil = () => stil(val('stil') || (kcCfg?.stilovi?.[0] ?? 'pisana'));
  const kcRows = () => Array.from(form.querySelectorAll<HTMLInputElement>('[data-kc-name]'));
  // šarene boje slova: boje na stanju osim boje osnove i okvira
  const sarenoRed = ['roze', 'plava', 'svetlozelena', 'narandzasta', 'ljubicasta', 'crvena', 'tirkizna', 'zuta', 'zlatna', 'zelena', 'bela', 'siva', 'crna'];
  function sarene(n: number, izuzmi: string[]) {
    const lista = [...sarenoRed.filter((x) => naStanju.includes(x)), ...naStanju.filter((x) => !sarenoRed.includes(x))].filter((x) => !izuzmi.includes(x));
    const l = lista.length ? lista : naStanju;
    return Array.from({ length: n }, (_, i) => l[i % l.length]);
  }
  function kcRefreshRows() {
    if (!kcCfg) return;
    const rows = kcRows();
    rows.forEach((inp, i) => {
      const del = inp.parentElement?.querySelector<HTMLElement>('[data-kc-del]');
      if (del) del.hidden = rows.length <= kcCfg.minImena;
      inp.placeholder = 'npr. ' + PRIMERI[i % PRIMERI.length];
      inp.id = 'kc-' + i;
      const l = inp.parentElement?.querySelector('label'); if (l) { l.setAttribute('for', 'kc-' + i); l.textContent = 'Ime ' + (i + 1); }
    });
    if (kcAdd) kcAdd.hidden = rows.length >= kcCfg.maxImena;
  }
  const sarSloj = (s: { sareno?: Sloj }) => s.sareno || 'slova';
  const izuzmi = (s: ReturnType<typeof kcStil>) => {
    const v = (sl: Sloj) => val(sl) || s.def[sl];
    return sarSloj(s) === 'okvir' ? [v('osnova'), v('slova')] : [v('osnova'), s.slojevi.includes('okvir') ? v('okvir') : ''];
  };
  function kcSetDefaults() {
    const s = kcStil();
    // „Šareno” je na sloju koji stil menja (slova ili okvir)
    const sar = sarSloj(s), drugi: Sloj = sar === 'slova' ? 'okvir' : 'slova';
    const mixSkriven = form.querySelector<HTMLInputElement>(`[data-layer="${drugi}"] input[value="sareno"]`);
    const mixVidljiv = form.querySelector<HTMLInputElement>(`[data-layer="${sar}"] input[value="sareno"]`);
    if (mixVidljiv) (mixVidljiv.closest('label') as HTMLElement).hidden = false;
    if (mixSkriven) {
      (mixSkriven.closest('label') as HTMLElement).hidden = true;
      if (mixSkriven.checked) {
        mixSkriven.checked = false;
        touched.delete(drugi);
        if (mixVidljiv) { mixVidljiv.checked = true; const nm = mixVidljiv.closest('[data-cp]')?.querySelector('[data-cp-name]'); if (nm) nm.textContent = mixVidljiv.dataset.label || ''; touched.delete(sar); }
      }
    }
    (['slova', 'okvir', 'osnova'] as Sloj[]).forEach((sl) => {
      const fs = form.querySelector<HTMLElement>(`[data-layer="${sl}"]`);
      if (!fs) return;
      if (sl === 'okvir') fs.hidden = !s.slojevi.includes('okvir');
      const izabrano = val(sl);
      if (izabrano === 'sareno' || (izabrano && touched.has(sl))) return;
      const inp = fs.querySelector<HTMLInputElement>(`input[value="${s.def[sl]}"]`) || fs.querySelector<HTMLInputElement>('input[data-hex]');
      if (inp) { inp.checked = true; const nm = fs.querySelector('[data-cp-name]'); if (nm) nm.textContent = inp.dataset.label || ''; }
    });
  }
  let kcJob = 0;
  async function drawKc() {
    if (!kcCfg || !kcSvg || kcSvg.closest('[hidden]')) return;
    const s = kcStil();
    const imena = kcRows().map((inp, i) => inp.value.trim() || PRIMERI[i % PRIMERI.length]);
    const okvir = val('okvir') || s.def.okvir, osnova = val('osnova') || s.def.osnova;
    const slova = val('slova') || s.def.slova;
    const jeSareno = (sarSloj(s) === 'okvir' ? okvir : slova) === 'sareno';
    const job = ++kcJob;
    await ucitajFont(s, imena.join(''));
    if (job !== kcJob || kcSvg.closest('[hidden]')) return;
    nacrtaj(kcSvg, {
      imena, stil: s,
      boje: { slova: hex(slova === 'sareno' ? s.def.slova : slova), okvir: hex(okvir === 'sareno' ? s.def.okvir : okvir), osnova: hex(osnova) },
      poImenu: jeSareno ? sarene(imena.length, izuzmi(s)).map(hex) : undefined,
    });
  }
  if (kcCfg) {
    kcAdd?.addEventListener('click', () => {
      const rows = kcRows(); if (rows.length >= kcCfg.maxImena) return;
      const last = rows[rows.length - 1].parentElement!;
      const row = last.cloneNode(true) as HTMLElement;
      const inp = row.querySelector<HTMLInputElement>('[data-kc-name]')!; inp.value = '';
      last.after(row); kcRefreshRows(); inp.focus(); showLive(); drawKc();
    });
    kcBox?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('[data-kc-del]');
      if (!b || kcRows().length <= kcCfg.minImena) return;
      b.parentElement?.remove(); kcRefreshRows(); showLive(); drawKc();
    });
    kcRefreshRows(); kcSetDefaults(); drawKc();
    document.fonts?.ready.then(() => drawKc());
  }

  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (kcCfg) {
      if (t.name === 'stil') kcSetDefaults();
      if (['slova', 'okvir', 'osnova'].includes(t.name)) touched.add(t.name);
      drawKc();
      if (t.matches('[data-kc-name], input[name="stil"], input[name="slova"], input[name="okvir"], input[name="osnova"]')) showLive();
      return;
    }
    updateOrn();
    if (t.matches('[data-ime], [data-set-name], input[name="motiv"], input[name="boja"], input[name="bojaImena"], input[name="broj"]')) showLive();
  });
  // ime iz adrese (?ime=Mila), npr. sa početne strane
  const qIme = new URLSearchParams(location.search).get('ime');
  const imeInp = form.querySelector<HTMLInputElement>('[data-ime]');
  if (qIme && imeInp) imeInp.value = qIme.slice(0, 12);
  updateOrn();

  // ——— Izbor motiva (npr. modlice) ———
  const motEl = form.querySelector<HTMLElement>('[data-motivi]');
  const motCfg = motEl ? (JSON.parse(motEl.dataset.motivi || '{}') as { lista: { id: string; naziv: string; slika: boolean }[]; popusti: { od: number; procenat: number }[]; cena: number }) : null;
  const motN = new Map<string, number>();
  const motUkupno = () => [...motN.values()].reduce((a, b) => a + b, 0);
  const motPopust = (n: number) => (motCfg ? motCfg.popusti.filter((x) => n >= x.od).reduce((a, x) => Math.max(a, x.procenat), 0) : 0);
  const motCena = (n: number) => (motCfg ? Math.round((n * motCfg.cena * (1 - motPopust(n) / 100)) / 10) * 10 : 0);
  const dinar = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ' din';
  const kom = (n: number) => (n === 1 ? 'komad' : 'komada');
  const pop = (el: Element | null) => { if (!el) return; el.classList.remove('pop'); void (el as HTMLElement).offsetWidth; el.classList.add('pop'); };
  let motPrethodni = 0;
  function motCrtaj() {
    if (!motCfg || !motEl) return;
    const n = motUkupno();
    const pct = motPopust(n);
    motEl.querySelectorAll<HTMLElement>('[data-mot]').forEach((t) => {
      const k = motN.get(t.dataset.mot!) || 0;
      t.classList.toggle('on', k > 0);
      t.querySelector('[data-mot-pick]')!.setAttribute('aria-pressed', String(k > 0));
      const st = t.querySelector<HTMLElement>('[data-mot-step]')!;
      st.hidden = k === 0;
      st.querySelector('[data-mot-n]')!.textContent = String(k);
    });
    const P = motCfg.popusti;
    const max = P.length ? P[P.length - 1].od : 1;
    const x = Math.min(n, max) / max;
    motEl.querySelector<HTMLElement>('[data-mm-fill]')?.style.setProperty('width', `${x * 100}%`);
    const bee = motEl.querySelector<HTMLElement>('[data-mm-bee]');
    if (bee) { bee.style.left = `${x * 100}%`; if (n !== motPrethodni) pop(bee); }
    motEl.querySelectorAll<HTMLElement>('[data-mm-stop]').forEach((s) => {
      const bio = s.classList.contains('on');
      const sad = n >= Number(s.dataset.mmStop);
      s.classList.toggle('on', sad);
      if (sad && !bio) pop(s);
    });
    motEl.querySelector('[data-mm-count]')!.textContent = `${n} kom`;
    const badge = motEl.querySelector<HTMLElement>('[data-mm-badge]')!;
    const staro = motPopust(motPrethodni);
    badge.hidden = pct === 0;
    badge.textContent = `Popust ${pct}%`;
    if (pct > staro) pop(badge);
    const sledeci = P.find((s) => s.od > n);
    const txt = motEl.querySelector('[data-mm-text]')!;
    if (n === 0) txt.textContent = P[0] ? `Od ${P[0].od} komada dobijate popust ${P[0].procenat}%.` : 'Kliknite motive koje želite.';
    else if (sledeci) { const fali = sledeci.od - n; txt.textContent = pct ? `Još ${fali} ${kom(fali)} i popust je ${sledeci.procenat}%.` : `Još ${fali} ${kom(fali)} do popusta od ${sledeci.procenat}%.`; }
    else txt.textContent = P.length ? 'Imate najveći popust.' : '';
    const tot = motEl.querySelector<HTMLElement>('[data-mm-total]');
    if (tot) {
      tot.hidden = n === 0 || !motCfg.cena;
      tot.innerHTML = n ? `Ukupno <strong>${dinar(motCena(n))}</strong>${pct ? ` <s>${dinar(n * motCfg.cena)}</s>` : ''}` : '';
    }
    if (n > 0) motEl.querySelector('[data-err-mot]')!.textContent = '';
    motPrethodni = n;
  }
  if (motCfg && motEl) {
    motEl.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-mot]');
      const b = (e.target as HTMLElement).closest('button');
      if (!t || !b) return;
      const mid = t.dataset.mot!;
      const k = motN.get(mid) || 0;
      if (b.matches('[data-mot-pick]')) motN.set(mid, k > 0 ? 0 : 1);
      else if (b.matches('[data-mot-inc]')) motN.set(mid, Math.min(20, k + 1));
      else if (b.matches('[data-mot-dec]')) motN.set(mid, Math.max(0, k - 1));
      if ((motN.get(mid) || 0) > 0 && b.matches('[data-mot-pick], [data-mot-inc]')) showSlide(`m-${mid}`);
      motCrtaj();
    });
    motCrtaj();
  }

  const greska = (el: HTMLElement | null, msg: string) => { if (el) { el.textContent = msg; el.style.color = 'var(--berry)'; } };

  // Slanje: složi poruku i otvori prozor za Messenger
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const lines: string[] = [];
    let qty = kol ? clamp(+kol.value) : 1;
    if (personal === 'ukras') {
      const v = imeInp?.value.trim() || '';
      if (!v) { imeInp?.focus(); imeInp?.setAttribute('aria-invalid', 'true'); greska(form.querySelector('[data-err-ime]'), 'Upišite ime koje štampamo.'); return; }
      imeInp?.removeAttribute('aria-invalid');
      lines.push('Ime: ' + v);
    }
    if (personal === 'set') {
      const n = val('broj') === '5' ? 5 : 4;
      const names = Array.from({ length: n }, (_, i) => form.querySelector<HTMLInputElement>(`[data-set-name="${i}"]`)?.value.trim() || '').filter(Boolean);
      if (names.length < n) {
        greska(form.querySelector('[data-err-names]'), n === 4 ? 'Upišite sva 4 imena.' : 'Upišite svih 5 imena.');
        form.querySelector<HTMLInputElement>('[data-set-name]:placeholder-shown')?.focus();
        return;
      }
      lines.push('Broj ukrasa: ' + n, 'Imena: ' + names.join(', '));
    }
    if (personal === 'ukras' || personal === 'set') {
      lines.push('Motiv: ' + lab('motiv'), 'Boja ukrasa: ' + lab('boja'), 'Boja imena: ' + lab('bojaImena'));
    }
    if (motCfg && motEl) {
      const n = motUkupno();
      if (!n) {
        greska(motEl.querySelector('[data-err-mot]'), 'Izaberite bar jedan motiv.');
        const g = motEl.querySelector('[data-mot-grid]'); pop(g);
        motEl.querySelector<HTMLButtonElement>('[data-mot-pick]')?.focus();
        return;
      }
      lines.push('Motivi: ' + motCfg.lista.filter((m) => motN.get(m.id)).map((m) => m.naziv + ((motN.get(m.id) || 0) > 1 ? ' ×' + motN.get(m.id) : '')).join(', '));
      const pct = motPopust(n);
      if (pct) lines.push('Popust: ' + pct + '%');
      if (motCfg.cena) lines.push('Cena: ' + dinar(motCena(n)) + (pct ? ' (umesto ' + dinar(n * motCfg.cena) + ')' : ''));
      qty = n;
    }
    if (kcCfg) {
      const rows = kcRows();
      const names = rows.map((r) => r.value.trim()).filter(Boolean);
      if (names.length < Math.max(1, kcCfg.minImena)) {
        greska(form.querySelector('[data-err-names]'), kcCfg.minImena > 1 ? `Upišite najmanje ${kcCfg.minImena} imena.` : 'Upišite ime koje štampamo.');
        rows.find((r) => !r.value.trim())?.focus();
        return;
      }
      const s = kcStil();
      const sl = sarSloj(s);
      const jeSareno = val(sl) === 'sareno';
      lines.push('Stil slova: ' + s.label);
      if (jeSareno) {
        const sar = sarene(names.length, izuzmi(s));
        lines.push(`Imena i boja ${sl === 'okvir' ? 'okvira' : 'slova'}: ` + names.map((n, i) => `${n} (${naziv(sar[i]).toLowerCase()})`).join(', '));
      } else {
        lines.push((names.length > 1 ? 'Imena: ' : 'Ime: ') + names.join(', '));
      }
      if (!(jeSareno && sl === 'slova')) lines.push('Boja slova: ' + lab('slova'));
      if (s.slojevi.includes('okvir') && !(jeSareno && sl === 'okvir')) lines.push('Boja okvira: ' + lab('okvir'));
      lines.push('Boja osnove: ' + lab('osnova'));
      qty = names.length;
    }
    form.querySelectorAll<HTMLElement>('[data-color-choice]').forEach((fs) => {
      const inp = fs.querySelector<HTMLInputElement>('input:checked');
      if (inp) lines.push(fs.dataset.colorChoice + ': ' + inp.dataset.label);
    });
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-option]').forEach((el) => {
      if (el instanceof HTMLInputElement && !el.checked) return;
      lines.push(el.dataset.option + ': ' + el.value);
    });
    const nap = (form.querySelector<HTMLInputElement>('input[name="napomena"]')?.value || '').trim();
    if (nap) lines.push('Napomena: ' + nap);
    (window as any).bumbaruOrder(id, lines, qty);
  });
</script>

