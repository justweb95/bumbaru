---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import PretragaPolje from '../../components/PretragaPolje.astro';
import Odbrojavanje from '../../components/Odbrojavanje.astro';
import Nedavno from '../../components/Nedavno.astro';
import { CATEGORIES, catUrl } from '../../data/categories';
import { PRODUCTS, inCategory, hasPhoto, cardImg, productUrl } from '../../data/products';
import { messengerUrl } from '../../data/site';
import { AKCIJA } from '../../lib/cene';

// slika kategorije: prva prava fotografija iz kategorije, različita za svaku kategoriju
const iskorisceno = new Set<string>();
const kat = CATEGORIES.map((c) => {
  const list = inCategory(c.slug).sort((a, b) => Number(hasPhoto(b)) - Number(hasPhoto(a)));
  const sa = list.filter((x) => x.images[0]);
  const p = sa.find((x) => x.images[0].src.startsWith('/img/p/') && !iskorisceno.has(x.slug)) || sa.find((x) => !iskorisceno.has(x.slug));
  if (p) iskorisceno.add(p.slug);
  return { c, list, slika: p ? cardImg(p.images[0]) : c.bg, ime: c.slug === 'nova-godina' ? 'Nova godina' : c.label };
});
const plural = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'proizvod' : 'proizvoda');
// Polaroidi u vrhu: po jedna prava fotografija iz različitih kategorija
const uzete = new Set<string>();
const polaroidi = CATEGORIES.map((c) => inCategory(c.slug).find((p) => p.images[0]?.src.startsWith('/img/p/') && !uzete.has(p.slug) && uzete.add(p.slug)))
  .filter(Boolean).slice(0, 5) as typeof PRODUCTS;
// gornji red od tri, donji red centriran ispod (jedna ili dve slike)
const GORE = [{ r: -6, l: 0, t: 4 }, { r: 4, l: 34, t: 0 }, { r: -3, l: 68, t: 6 }];
const DOLE = polaroidi.length > 4 ? [{ r: 5, l: 17, t: 50 }, { r: -4, l: 51, t: 52 }] : [{ r: 4, l: 34, t: 50 }];
const POL = [...GORE, ...DOLE];
const tonovi = ['tone-honey', 'tone-wing', 'tone-leaf', 'tone-lilac', 'tone-berry', 'tone-peach'];
const ukupno = PRODUCTS.length;
const brojKat = CATEGORIES.filter((c) => !c.soon).length;
---
<Base title="Katalog: ukrasi, pokloni sa imenom, dom, radionica i auto | Bumbaru" description="Ceo Bumbaru katalog: novogodišnji ukrasi i privesci, pokloni sa imenom, dekoracija za dom i kuhinju, držači za aku alat i delovi za auto i motor. Poručivanje preko Messengera." current="katalog">
  <div class="paper-zone">
    <div class="wrap">
      <Crumbs items={[{ label: 'Katalog' }]} />
      <nav class="tabs" aria-label="Kategorije">
        <a class="tab" href="/katalog/" aria-current="page">Sve kategorije</a>
        {kat.map(({ c, ime }) => <a class="tab" href={catUrl(c.slug)}>{ime}</a>)}
      </nav>

      <!-- Vrh: naslov, pretraga i polaroidi proizvoda -->
      <section class="k-hero" aria-labelledby="k-title">
        <div class="k-hero-txt">
          <span class="badge badge-honey">Katalog</span>
          <h1 id="k-title" class="h1">Sve što štampamo, na jednom mestu</h1>
          <p class="lead">Izaberite kategoriju ili pretražite katalog. Kliknite na proizvod, izaberite šta vam treba i pošaljite poruku preko Messengera.</p>
          <PretragaPolje />
          <ul class="k-stats">
            <li><b>{ukupno}</b><span>proizvoda</span></li>
            <li><b>{brojKat}</b><span>kategorija</span></li>
            <li><b>3D</b><span>štampa iz Leskovca</span></li>
          </ul>
        </div>
        <div class="k-hero-art" aria-hidden="true">
          <svg class="k-trail" viewBox="0 0 300 220"><path d="M10 200 C 60 120, 140 190, 160 120 S 110 40, 170 36 S 270 70, 290 20" fill="none" stroke="#312018" stroke-width="3" stroke-linecap="round" stroke-dasharray="0 10" /></svg>
          {polaroidi.map((p, i) => (
            <a class="k-pol" href={productUrl(p.slug)} tabindex="-1" style={`--r:${POL[i].r}deg;left:${POL[i].l}%;top:${POL[i].t}%;--d:${i}`}>
              <img src={cardImg(p.images[0])} alt="" width="900" height="900" loading="eager" />
              <span>{p.title}</span>
            </a>
          ))}
          <img class="k-bee fx-float" src="/img/brand/pcelica.webp" alt="" width="90" height="90" />
        </div>
      </section>

      <!-- Kategorije -->
      <nav class="k-tiles" aria-label="Kategorije sa slikama">
        {kat.map(({ c, list, slika, ime }, i) => (
          <a class="k-tile" href={c.soon ? catUrl(c.slug) : `#k-${c.slug}`} style={`--r:${i % 2 ? 1.2 : -1.2}deg`}>
            <span class="k-img"><img src={slika} alt="" width="300" height="300" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" /></span>
            <span class="k-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg></span>
            <span class="k-name">{ime}</span>
            <span class="k-cnt">{c.soon ? 'Uskoro' : `${list.length} ${plural(list.length)}`}</span>
          </a>
        ))}
      </nav>

      <!-- Po kategoriji: šarene ploče sa proizvodima -->
      {kat.filter(({ c }) => !c.soon).map(({ c, list, ime }, i) => (
        <section class={`k-sec ${tonovi[i % tonovi.length]}`} id={`k-${c.slug}`} aria-labelledby={`kh-${c.slug}`}>
          <div class="k-sec-head">
            <div class="k-sec-t">
              <span class="kicon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg></span>
              <div>
                <h2 id={`kh-${c.slug}`} class="h2">{c.slug === 'nova-godina' ? 'Novogodišnji katalog' : ime}</h2>
                <p class="muted">{c.text}</p>
              </div>
            </div>
            <div class="k-sec-act">
              {AKCIJA && AKCIJA.kategorija === c.slug && <Odbrojavanje mali />}
              <a class="btn btn-paper" href={catUrl(c.slug)}>{list.length > 4 ? `Svih ${list.length} proizvoda` : 'Cela kategorija'}<Icon name="arrow" /></a>
            </div>
          </div>
          <div class="grid rail-mobile">
            {list.slice(0, 4).map((p) => <ProductCard p={p} />)}
          </div>
        </section>
      ))}
      {kat.filter(({ c }) => c.soon).map(({ c }) => (
        <section class="k-sec k-soon" aria-labelledby={`kh-${c.slug}`}>
          <img src="/img/c/igracke-sm.webp" alt="" width="600" height="600" loading="lazy" />
          <div>
            <span class="badge badge-berry">Uskoro</span>
            <h2 id={`kh-${c.slug}`} class="h2">{c.label}</h2>
            <p class="muted">{c.text}</p>
            <a class="btn" href={messengerUrl(`Zdravo, javite mi kad stigne kategorija ${c.label}.`, c.slug)} target="_blank" rel="noopener"><Icon name="messenger" />Javite mi kad krene</a>
          </div>
        </section>
      ))}

      <!-- Ništa nije zapalo za oko? -->
      <div class="k-cta">
        <a class="k-cta-card k-cta-kviz" href="/nadji-poklon/">
          <img class="fx-float" src="/img/brand/pcelica.webp" alt="" width="72" height="72" loading="lazy" />
          <span><b class="h3">Ne znate šta da izaberete?</b><span class="small">Četiri brza pitanja i predlažemo vam poklon iz kataloga.</span></span>
          <span class="btn btn-primary"><Icon name="sparkle" />Nađi poklon</span>
        </a>
        <a class="k-cta-card k-cta-meri" href="/po-meri/">
          <span class="k-cta-ic"><Icon name="layers" size={28} /></span>
          <span><b class="h3">Niste našli šta tražite?</b><span class="small">Pošaljite ideju, meru ili fotografiju, pa javljamo cenu i rok izrade.</span></span>
          <span class="btn btn-paper">Pošaljite upit</span>
        </a>
      </div>

      <Nedavno />
    </div>
  </div>
</Base>
<style>
  .tabs { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; margin-bottom: 20px; scrollbar-width: none; }
  .tabs::-webkit-scrollbar { display: none; }
  .tab { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 2px solid var(--ink); border-radius: var(--r-pill); font-weight: 700; text-decoration: none; white-space: nowrap; background: var(--surface-paper); }
  .tab:hover { background: var(--surface-raised); }
  .tab[aria-current="page"] { background: var(--ink); color: var(--cream); }

  .k-hero { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 480px); gap: 32px; align-items: center; min-height: 420px; padding: 40px 48px; border-radius: var(--r-lg); background: var(--honey-soft); overflow: hidden; overflow: clip; }
  .k-hero::before { content: ''; position: absolute; right: -120px; bottom: -160px; width: 460px; height: 460px; border-radius: 50%; background: var(--honey); opacity: .55; }
  .k-hero > * { position: relative; }
  .k-hero-txt { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .k-hero-txt .lead { max-width: 560px; color: var(--ink); }
  .k-stats { list-style: none; display: flex; gap: 10px; flex-wrap: wrap; margin: 4px 0 0; padding: 0; }
  .k-stats li { display: flex; flex-direction: column; align-items: center; min-width: 96px; padding: 10px 14px; border-radius: 16px; background: var(--surface-paper); line-height: 18px; }
  .k-stats b { font-size: 22px; line-height: 26px; font-weight: 800; }
  .k-stats span { font-size: 12px; font-weight: 700; color: var(--ink-muted); text-align: center; }
  .k-hero-art { position: relative; height: 340px; }
  .k-trail { position: absolute; inset: 10% 0 0 0; width: 100%; height: 80%; opacity: .6; }
  .k-pol { position: absolute; width: 31%; padding: 7px 7px 9px; background: var(--surface-paper); border-radius: 10px; box-shadow: var(--shadow); transform: rotate(var(--r)); text-decoration: none; display: flex; flex-direction: column; gap: 5px; animation: k-drop .6s cubic-bezier(.3,1.4,.5,1) both; animation-delay: calc(var(--d) * 90ms + 150ms); }
  .k-pol::before { content: ''; position: absolute; left: 50%; top: -9px; width: 48px; height: 18px; margin-left: -24px; background: rgba(245,193,55,.75); transform: rotate(-3deg); }
  .k-pol img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 6px; }
  .k-pol span { font-size: 11px; line-height: 14px; font-weight: 700; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .k-bee { position: absolute; right: 2%; top: -2%; width: 78px; height: auto; }
  @keyframes k-drop { from { opacity: 0; transform: translateY(-24px) rotate(calc(var(--r) * -2)); } to { opacity: 1; transform: rotate(var(--r)); } }

  .k-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; margin-top: 28px; }
  .k-tile { position: relative; display: flex; flex-direction: column; gap: 2px; padding: 8px 8px 14px; border-radius: 22px; background: var(--surface-raised); text-decoration: none; color: var(--ink); border: 2px solid transparent; transition: transform .35s var(--ease), box-shadow .35s ease, border-color .2s; }
  .k-img { display: block; aspect-ratio: 1; border-radius: 16px; overflow: hidden; background: var(--surface-paper); margin-bottom: 10px; }
  .k-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
  .k-ic { position: absolute; left: 16px; top: 16px; width: 36px; height: 36px; border-radius: 50%; background: var(--honey); border: 2px solid var(--ink); display: inline-flex; align-items: center; justify-content: center; }
  .k-name { font-weight: 800; font-size: 16px; line-height: 21px; padding: 0 6px; }
  .k-cnt { font-size: 13px; line-height: 18px; color: var(--ink-muted); padding: 0 6px; }

  .k-sec { margin-top: 32px; padding: 32px; border-radius: var(--r-lg); scroll-margin-top: 100px; background: var(--tone, var(--surface-raised)); }
  .tone-honey { --tone: #F7EBC4; }
  .tone-wing { --tone: var(--wing); }
  .tone-leaf { --tone: var(--leaf-soft); }
  .tone-lilac { --tone: #E5DDF0; }
  .tone-berry { --tone: var(--berry-soft); }
  .tone-peach { --tone: #F8DEC0; }
  .k-sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap; margin-bottom: 24px; }
  .k-sec-t { display: flex; gap: 14px; align-items: flex-start; max-width: 720px; }
  .k-sec-t p { margin-top: 6px; }
  .k-sec-act { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .k-sec .btn :global(svg) { margin-left: 2px; }
  .kicon { flex: none; width: 44px; height: 44px; border-radius: 50%; background: var(--honey); border: 2px solid var(--ink); display: inline-flex; align-items: center; justify-content: center; }
  .k-sec :global(.card .media) { background: var(--surface-paper); }
  .k-soon { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 32px; align-items: center; background: #F4E2AA; }
  .k-soon img { width: 100%; border-radius: 18px; }
  .k-soon > div { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }

  .k-cta { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 48px; }
  .k-cta-card { display: flex; align-items: center; gap: 16px; padding: 24px; border-radius: var(--r-lg); text-decoration: none; color: var(--ink); transition: transform .35s var(--ease); }
  .k-cta-card > span:nth-child(2) { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
  .k-cta-card .btn { flex: none; }
  .k-cta-kviz { background: var(--honey-soft); border: 2px dashed var(--ink); }
  .k-cta-kviz img { width: 60px; height: auto; flex: none; }
  .k-cta-meri { background: var(--dark); color: var(--cream); }
  .k-cta-meri .small { color: var(--cream-muted); }
  .k-cta-ic { flex: none; width: 56px; height: 56px; border-radius: 50%; background: var(--honey); color: var(--ink); display: inline-flex; align-items: center; justify-content: center; }

  @media (hover: hover) {
    .k-tile:hover { transform: translateY(-5px) rotate(var(--r)); box-shadow: var(--shadow); border-color: var(--ink); }
    .k-tile:hover .k-img img { transform: scale(1.06); }
    .k-cta-card:hover { transform: translateY(-4px) rotate(-.6deg); }
  }
  @media (max-width: 1000px) {
    .k-hero { grid-template-columns: 1fr; }
    .k-hero-art { height: 300px; max-width: 520px; width: 100%; justify-self: center; }
    .k-cta { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .k-hero { padding: 24px 18px 20px; gap: 20px; min-height: 0; }
    .k-hero::before { width: 300px; height: 300px; right: -120px; bottom: -120px; }
    .k-hero-art { height: 250px; }
    .k-pol { width: 31%; }
    .k-tiles { display: flex; overflow-x: auto; margin: 20px -16px 0; padding: 4px 16px 10px; gap: 12px; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .k-tiles::-webkit-scrollbar { display: none; }
    .k-tile { flex: none; width: 140px; scroll-snap-align: start; }
    .k-sec { padding: 20px 16px; margin-top: 20px; border-radius: 24px; }
    .k-sec-head { margin-bottom: 16px; }
    .k-soon { grid-template-columns: 1fr; gap: 16px; }
    .k-soon img { max-width: 200px; }
    .k-cta-card { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 14px; padding: 20px; }
    .k-cta-card .btn { grid-column: 1 / -1; justify-self: start; }
    .k-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; gap: 8px; }
    .k-stats li { min-width: 0; padding: 10px 6px; }
    .kicon { width: 38px; height: 38px; }
    .k-sec-t { gap: 10px; }
  }
  @media (prefers-reduced-motion: reduce) { .k-pol { animation: none; } .k-tile, .k-img img, .k-cta-card { transition: none; } }
</style>
