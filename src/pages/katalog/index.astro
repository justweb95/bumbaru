---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { CATEGORIES, catUrl } from '../../data/categories';
import { inCategory, hasPhoto, cardImg } from '../../data/products';

const kat = CATEGORIES.map((c) => {
  const list = inCategory(c.slug).sort((a, b) => Number(hasPhoto(b)) - Number(hasPhoto(a)));
  const p = list.find((x) => x.images[0]);
  return { c, list, slika: p ? cardImg(p.images[0]) : c.bg };
});
const plural = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'proizvod' : 'proizvoda');
---
<Base title="Katalog: ukrasi, pokloni sa imenom, dom, radionica i auto | Bumbaru" description="Ceo Bumbaru katalog: novogodišnji ukrasi i privesci, pokloni sa imenom, dekoracija za dom i kuhinju, držači za aku alat i delovi za auto i motor. Poručivanje preko Messengera." current="katalog">
  <div class="wrap">
    <Crumbs items={[{ label: 'Katalog' }]} />
    <div class="k-head">
      <div>
        <h1 class="h1">Katalog</h1>
        <p class="lead" style="margin-top:10px;max-width:680px">Sve što štampamo, po kategorijama. Kliknite na proizvod, izaberite šta vam treba i pošaljite poruku preko Messengera.</p>
      </div>
      <a class="btn" href="/pretraga/"><Icon name="search" />Pretražite katalog</a>
    </div>

    <nav class="k-tiles" aria-label="Kategorije">
      {kat.map(({ c, list, slika }, i) => (
        <a class="k-tile" href={c.soon ? catUrl(c.slug) : `#k-${c.slug}`} style={`--r:${i % 2 ? 1.2 : -1.2}deg`}>
          <span class="k-img"><img src={slika} alt="" width="300" height="300" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" /></span>
          <span class="k-ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg></span>
          <span class="k-name">{c.slug === 'nova-godina' ? 'Nova godina' : c.label}</span>
          <span class="k-cnt">{c.soon ? 'Uskoro' : `${list.length} ${plural(list.length)}`}</span>
        </a>
      ))}
    </nav>

    {kat.filter(({ c }) => !c.soon).map(({ c, list }) => (
      <section class="kat" id={`k-${c.slug}`} aria-labelledby={`kh-${c.slug}`}>
        <div class="sec-head">
          <div style="display:flex;gap:14px;align-items:center">
            <span class="kicon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg></span>
            <h2 id={`kh-${c.slug}`} class="h2">{c.slug === 'nova-godina' ? 'Novogodišnji katalog' : c.label}</h2>
          </div>
          <a class="link-arrow" href={catUrl(c.slug)}>{list.length > 4 ? `Svih ${list.length} iz kategorije` : 'Sve iz kategorije'}<Icon name="arrow" /></a>
        </div>
        <div class="grid rail-mobile">
          {list.slice(0, 4).map((p) => <ProductCard p={p} />)}
        </div>
      </section>
    ))}
    {kat.filter(({ c }) => c.soon).map(({ c }) => (
      <section class="kat" aria-labelledby={`kh-${c.slug}`}>
        <div class="sec-head"><h2 id={`kh-${c.slug}`} class="h2">{c.label}</h2><a class="link-arrow" href={catUrl(c.slug)}>Uskoro<Icon name="arrow" /></a></div>
      </section>
    ))}
  </div>
</Base>
<style>
  .k-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .k-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; margin-top: 32px; }
  .k-tile { position: relative; display: flex; flex-direction: column; gap: 2px; padding: 8px 8px 14px; border-radius: 22px; background: var(--surface-paper); text-decoration: none; color: var(--ink); transition: transform .35s var(--ease), box-shadow .35s ease; }
  .k-img { display: block; aspect-ratio: 1; border-radius: 16px; overflow: hidden; background: var(--surface-raised); margin-bottom: 10px; }
  .k-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
  .k-ic { position: absolute; left: 16px; top: 16px; width: 36px; height: 36px; border-radius: 50%; background: var(--honey); border: 2px solid var(--ink); display: inline-flex; align-items: center; justify-content: center; }
  .k-name { font-weight: 800; font-size: 16px; line-height: 21px; padding: 0 6px; }
  .k-cnt { font-size: 13px; line-height: 18px; color: var(--ink-muted); padding: 0 6px; }
  .kat { margin-top: 64px; scroll-margin-top: 100px; }
  .kicon { width: 40px; height: 40px; border-radius: 50%; background: var(--honey); border: 2px solid var(--ink); display: inline-flex; align-items: center; justify-content: center; }
  @media (hover: hover) {
    .k-tile:hover { transform: translateY(-5px) rotate(var(--r)); box-shadow: var(--shadow); }
    .k-tile:hover .k-img img { transform: scale(1.06); }
  }
  @media (max-width: 760px) {
    .k-tiles { display: flex; overflow-x: auto; margin: 24px -16px 0; padding: 4px 16px 10px; gap: 12px; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .k-tiles::-webkit-scrollbar { display: none; }
    .k-tile { flex: none; width: 140px; scroll-snap-align: start; }
    .k-head .btn { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .k-tile, .k-img img { transition: none; } }
</style>
