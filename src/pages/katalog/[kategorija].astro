---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import Accordion from '../../components/Accordion.astro';
import { CATEGORIES, catUrl, type Category } from '../../data/categories';
import { inCategory, hasPhoto, productUrl } from '../../data/products';
import { SITE, messengerUrl } from '../../data/site';

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { kategorija: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Category };
// Proizvodi sa fotografijom idu prvi, pa sa crtežom, pa bez fotografije.
const list = inCategory(c.slug).sort((a, b) => Number(hasPhoto(b)) - Number(hasPhoto(a)));
const counts = (c.filters || []).map((f) => ({ ...f, n: f.id === 'sve' ? list.length : list.filter((p) => (p.tags || []).includes(f.id)).length })).filter((f) => f.n > 0);
const plural = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'proizvod' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? 'proizvoda' : 'proizvoda');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: c.title,
  url: SITE.url + catUrl(c.slug),
  mainEntity: { '@type': 'ItemList', itemListElement: list.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE.url + productUrl(p.slug), name: p.title })) },
};
const og = c.slug === 'nova-godina' || c.slug === 'pokloni-sa-imenom' ? '/img/og/bumbaru.jpg' : '/img/og/bumbaru.jpg';
---
<Base title={c.seoTitle} description={c.meta} image={og} current={c.slug} jsonld={[ld]}>
  <div class="paper-zone">
  <div class="wrap">
    <Crumbs items={[{ label: 'Katalog', href: '/katalog/' }, { label: c.label }]} />
    <nav class="tabs" aria-label="Kategorije">
      {CATEGORIES.map((k) => <a class="tab" href={catUrl(k.slug)} aria-current={k.slug === c.slug ? 'page' : undefined}>{k.label}</a>)}
    </nav>

    <section class="cat-hero" aria-labelledby="cat-title">
      <img class="cat-hero-bg" src={c.bg} alt="" width="1000" height="562" style={`object-position:${c.bgPos || 'center'}`} fetchpriority="high" />
      <div class="cat-hero-card">
        <span class="badge badge-honey">{c.label}</span>
        <h1 id="cat-title" class="h1">{c.title}</h1>
        <p class="muted">{c.text}</p>
      </div>
    </section>

    {c.soon ? (
      <section class="soon panel" aria-labelledby="soon-title">
        <img src="/img/c/igracke-sm.webp" alt="Crtež igračaka: čigra, kockice i gusenica" width="600" height="600" />
        <div>
          <span class="badge badge-berry">Uskoro</span>
          <h2 id="soon-title" class="h2" style="margin-top:12px">Igračke stižu uskoro</h2>
          <p class="muted" style="margin:10px 0 20px">Igračke stavljamo u prodaju tek kad prođu proveru bezbednosti. Javite nam šta vaše dete voli, pa vam pišemo kad krenu.</p>
          <div class="soon-actions">
            <a class="btn btn-primary btn-lg" href={messengerUrl('Zdravo, javite mi kad stignu igračke za decu.', 'igracke')} target="_blank" rel="noopener"><Icon name="messenger" />Javite mi na Messenger-u</a>
            <a class="link-arrow" href="/katalog/pokloni-sa-imenom/">Do tada: pokloni sa imenom<Icon name="arrow" /></a>
          </div>
        </div>
      </section>
    ) : (
      <section class="list" aria-label="Proizvodi">
        <div class="toolbar">
          {counts.length > 0 ? (
            <div class="chips" role="group" aria-label="Filter">
              {counts.map((f, i) => (
                <button class="chip" type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label} <span class="cnt">{f.n}</span></button>
              ))}
            </div>
          ) : <span />}
          <p class="small muted" data-count>{list.length} {plural(list.length)}</p>
        </div>
        <div class="grid" data-grid>
          {list.map((p, i) => <ProductCard p={p} eager={i < 4} tags />)}
        </div>
      </section>
    )}
  </div>
  </div>
  <div class="wrap">
    {!c.soon && (
      <section class="about" aria-labelledby="about-title">
        <div>
          <h2 id="about-title" class="h2">{c.about.h2}</h2>
          {c.about.p.map((t) => <p class="muted" style="margin-top:14px">{t}</p>)}
        </div>
        <div>
          <h2 class="h3" style="margin-bottom:8px">Česta pitanja</h2>
          <Accordion items={c.faq} />
        </div>
      </section>
    )}

    <section class="notfound" aria-labelledby="nf-title">
      <div>
        <h2 id="nf-title" class="h2">Niste našli šta tražite?</h2>
        <p class="muted" style="margin-top:8px">Pošaljite ideju, meru ili fotografiju. Javljamo cenu i rok izrade, a gotov proizvod šaljemo kurirom.</p>
      </div>
      <a class="btn btn-primary btn-lg" href="/po-meri/">Pošaljite upit</a>
    </section>
  </div>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] .card');
  const count = document.querySelector('[data-count]');
  const apply = (id: string) => {
    let n = 0;
    cards.forEach((c) => { const ok = id === 'sve' || (c.dataset.tags || '').split(' ').includes(id); c.hidden = !ok; if (ok) n++; });
    chips.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === id)));
    if (count) count.textContent = n + ' ' + (n % 10 === 1 && n % 100 !== 11 ? 'proizvod' : 'proizvoda');
  };
  chips.forEach((b) => b.addEventListener('click', () => {
    apply(b.dataset.filter || 'sve');
    const u = new URL(location.href);
    if (b.dataset.filter === 'sve') u.searchParams.delete('filter'); else u.searchParams.set('filter', b.dataset.filter || '');
    history.replaceState(null, '', u);
  }));
  const f = new URLSearchParams(location.search).get('filter');
  if (f && document.querySelector(`[data-filter="${CSS.escape(f)}"]`)) apply(f);
</script>

<style>
  .tabs { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; margin-bottom: 20px; scrollbar-width: none; }
  .tabs::-webkit-scrollbar { display: none; }
  .tab { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 2px solid var(--ink); border-radius: var(--r-pill); font-weight: 700; text-decoration: none; white-space: nowrap; background: var(--surface-paper); }
  .tab:hover { background: var(--surface-raised); }
  .tab[aria-current="page"] { background: var(--ink); color: var(--cream); }
  .cat-hero { position: relative; min-height: 380px; border-radius: var(--r-lg); overflow: hidden; display: flex; align-items: center; padding: 32px; background: var(--surface-raised); }
  .cat-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cat-hero-card { position: relative; max-width: 560px; background: var(--surface-paper); border-radius: 20px; padding: 32px; display: flex; flex-direction: column; gap: 14px; align-items: flex-start; box-shadow: var(--shadow); }
  @media (max-width: 760px) { .cat-hero { min-height: 0; padding: 140px 12px 12px; } .cat-hero-card { padding: 22px; } }
  .list { margin-top: 32px; }
  .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .chip .cnt { display: inline-flex; min-width: 22px; height: 22px; padding: 0 6px; align-items: center; justify-content: center; border-radius: var(--r-pill); background: var(--surface-paper); font-size: 12px; }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  .chip[aria-pressed="true"] .cnt { background: var(--honey); color: var(--ink); }
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin-top: 72px; }
  @media (max-width: 900px) { .about { grid-template-columns: 1fr; gap: 32px; margin-top: 56px; } }
  .soon { display: grid; grid-template-columns: 320px 1fr; gap: 40px; align-items: center; padding: 32px; margin-top: 32px; }
  .soon img { width: 100%; border-radius: 18px; }
  .soon-actions { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  @media (max-width: 760px) { .soon { grid-template-columns: 1fr; padding: 20px; gap: 20px; } .soon img { max-width: 240px; } }
  .notfound { margin-top: 64px; padding: 32px; border-radius: var(--r-lg); background: var(--honey-soft); display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
</style>
