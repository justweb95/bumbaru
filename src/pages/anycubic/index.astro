---
// Admin panel: proizvodi, kategorije, boje filamenta i podešavanja (logika je u src/admin/app.ts).
// Adresa namerno nije /admin/ i ne piše se u robots.txt ni u mapi sajta.
// Čuvanje ide preko /api/cms/ (prijava: src/lib/admin-auth.ts), a sajt se posle toga sam objavi ponovo.
import { readdirSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import proizvodi from '../../data/proizvodi.json';
import kategorije from '../../data/kategorije.json';
import boje from '../../data/boje.json';
import podesavanja from '../../data/podesavanja.json';

// Podaci iz ove objave: prikazuju se ako server za čuvanje ne radi
const podaci = { proizvodi: proizvodi.proizvodi, kategorije: kategorije.kategorije, boje: boje.boje, podesavanja: { prikaziCene: podesavanja.prikaziCene === true, ...((podesavanja as any).akcija ? { akcija: (podesavanja as any).akcija } : {}) } };
let pozadine: string[] = [];
try { pozadine = readdirSync('public/img/bg').filter((f) => /\.(webp|jpg|png)$/.test(f) && !/-tel\./.test(f)).map((f) => `/img/bg/${f}`); } catch { pozadine = ['/img/bg/kraft.webp']; }
---
<Base title="Admin | Bumbaru" description="Upravljanje sajtom." noindex>
  <div class="paper-zone">
  <section class="wrap adm">
    <div class="adm-head">
      <span class="badge badge-honey">Admin</span>
      <h1 class="h1">Bumbaru admin</h1>
    </div>

    <form class="card-box login" data-login>
      <div class="field">
        <label for="adm-user">Korisničko ime</label>
        <input id="adm-user" class="input" type="text" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" required data-user />
      </div>
      <div class="field">
        <label for="adm-pass">Lozinka</label>
        <input id="adm-pass" class="input" type="password" autocomplete="current-password" required data-pass />
      </div>
      <button class="btn btn-primary btn-lg" type="submit">Uđi</button>
      <p class="small" data-login-msg role="status"></p>
    </form>

    <div data-app hidden>
      <p class="banner" data-banner role="alert" hidden></p>
      <div class="tabs" role="tablist" aria-label="Delovi admina">
        <button type="button" role="tab" data-tab="proizvodi" aria-selected="true">Proizvodi <span class="num"></span></button>
        <button type="button" role="tab" data-tab="kategorije" aria-selected="false">Kategorije <span class="num"></span></button>
        <button type="button" role="tab" data-tab="boje" aria-selected="false">Boje <span class="num"></span></button>
        <button type="button" role="tab" data-tab="podesavanja" aria-selected="false">Podešavanja</button>
        <button type="button" role="tab" data-tab="kalkulator" aria-selected="false">Kalkulator</button>
      </div>
      <div class="panel" data-panel></div>
      <div class="save-bar" data-bar>
        <p class="small" data-msg role="status" aria-live="polite"></p>
        <button type="button" class="btn btn-primary btn-lg" data-save disabled>Sačuvaj i objavi</button>
      </div>
    </div>
  </section>
  </div>

  <script type="application/json" id="adm-data" set:html={JSON.stringify({ podaci, pozadine })} />
</Base>

<script>
  import '../../admin/app';
</script>

<style>
  .adm { padding-top: 32px; padding-bottom: 140px; max-width: 980px; }
  .adm-head { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; margin-bottom: 24px; }
  :global(.adm .card-box) { background: #F8F5F0; border-radius: var(--r-lg); padding: 28px; box-shadow: var(--shadow); }
  .login { display: flex; flex-direction: column; gap: 16px; max-width: 420px; }
  :global(.adm [data-tone="err"]) { color: var(--berry); font-weight: 700; }
  :global(.adm [data-tone="ok"]) { color: var(--leaf); font-weight: 700; }
  .banner { background: var(--berry-soft); color: var(--berry); font-weight: 700; padding: 14px 18px; border-radius: var(--r-sm); margin-bottom: 16px; }

  .tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 20px; }
  .tabs button { min-height: 44px; padding: 0 18px; border-radius: var(--r-pill); border: 2px solid var(--ink); background: transparent; font: inherit; font-weight: 700; cursor: pointer; color: var(--ink); }
  .tabs button[aria-selected="true"] { background: var(--ink); color: var(--surface-paper); }
  .tabs .num { opacity: .7; font-weight: 600; }

  .save-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; gap: 16px; align-items: center; justify-content: flex-end; padding: 14px max(24px, calc((100vw - 980px) / 2 + 24px)); background: var(--surface-paper); border-top: 1px solid var(--line); box-shadow: 0 -6px 24px rgba(49,32,24,.08); }
  .save-bar p { flex: 1; margin: 0; }
  :global(.save-bar.dirty) { background: var(--honey-soft); }

  /* zajedničko */
  :global(.adm .sec) { display: flex; flex-direction: column; gap: 16px; margin-bottom: 16px; }
  :global(.adm .sec > .h3) { margin-bottom: 2px; }
  :global(.adm .hint) { font-size: 13px; line-height: 18px; color: var(--ink-muted); margin: 0; }
  :global(.adm .hint.warn) { color: var(--ink); background: var(--honey-soft); padding: 10px 12px; border-radius: 10px; }
  :global(.adm .grid2) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  :global(.adm .stack) { display: flex; flex-direction: column; gap: 8px; }
  :global(.adm .pair) { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 8px; align-items: start; }
  :global(.adm .flabel) { font-size: 13px; line-height: 16px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  :global(.adm .textarea) { min-height: 0; }
  :global(.adm .cnt) { font-size: 12px; color: var(--ink-muted); align-self: flex-end; margin-top: -4px; }
  :global(.adm .cnt.over) { color: var(--berry); font-weight: 700; }
  :global(.adm .tag) { display: inline-block; font-size: 11px; line-height: 16px; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: var(--honey-soft); color: var(--ink); white-space: nowrap; }
  :global(.adm .tag-off) { background: var(--line); }
  :global(.adm .icon-btn.sm) { width: 38px; height: 38px; border-width: 1.5px; background: var(--surface-paper); }
  :global(.adm .icon-btn.sm:disabled) { opacity: .3; cursor: default; }
  :global(.adm .icon-btn.del), :global(.adm .btn-del) { color: var(--berry); }
  :global(.adm .btn-del) { border-color: var(--berry); }
  :global(.adm .tog-row) { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; }
  :global(.adm .tog) { display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-weight: 700; font-size: 15px; }
  :global(.adm .tog input) { position: absolute; opacity: 0; pointer-events: none; }
  :global(.adm .tog-ui) { flex: none; position: relative; width: 46px; height: 28px; border-radius: 999px; background: var(--line); transition: background .2s; }
  :global(.adm .tog-ui::after) { content: ''; position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: #fff; transition: transform .25s cubic-bezier(.3,.9,.35,1.2); }
  :global(.adm .tog input:checked + .tog-ui) { background: var(--leaf); }
  :global(.adm .tog input:checked + .tog-ui::after) { transform: translateX(18px); }
  :global(.adm .tog input:focus-visible + .tog-ui) { outline: 2px solid var(--ink); outline-offset: 3px; }
  :global(.adm .chips) { display: flex; flex-wrap: wrap; gap: 8px; }
  :global(.adm .chip) { position: relative; min-height: 40px; font-size: 14px; }
  :global(.adm .chip .chk) { width: 20px; height: 20px; border-radius: 6px; border: 2px solid var(--line-strong); display: inline-flex; align-items: center; justify-content: center; color: transparent; background: var(--surface-paper); }
  :global(.adm .chip:has(input:checked)) { border-color: var(--ink); }
  :global(.adm .chip:has(input:checked) .chk) { background: var(--ink); border-color: var(--ink); color: var(--surface-paper); }

  /* liste redova */
  :global(.adm .lst) { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  :global(.adm .lst-row) { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: start; padding: 10px; border-radius: 14px; background: var(--surface-raised); }
  :global(.adm .lst-acts) { display: flex; gap: 4px; }

  /* lista proizvoda / kategorija */
  :global(.adm .toolbar) { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 12px; }
  :global(.adm .toolbar .select) { width: auto; min-width: 190px; }
  :global(.adm .toolbar .grow) { flex: 1; margin: 0; }
  :global(.adm .adm-search) { position: relative; flex: 1; min-width: 220px; display: flex; align-items: center; }
  :global(.adm .adm-search svg) { position: absolute; left: 14px; color: var(--ink-muted); }
  :global(.adm .adm-search .input) { padding-left: 42px; }
  :global(.adm .plist) { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
  :global(.adm .prow) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; padding: 8px 10px 8px 8px; border-radius: 18px; background: #F8F5F0; box-shadow: var(--shadow); }
  :global(.adm .prow.off) { opacity: .62; }
  :global(.adm .prow-main) { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: 14px; align-items: center; text-align: left; background: none; border: 0; padding: 0; font: inherit; color: inherit; cursor: pointer; min-height: 56px; }
  :global(.adm .prow-main:focus-visible) { outline: 2px solid var(--ink); outline-offset: 4px; border-radius: 12px; }
  :global(.adm .pthumb) { width: 56px; height: 56px; border-radius: 12px; overflow: hidden; background: var(--surface-raised); display: flex; align-items: center; justify-content: center; color: var(--ink-muted); }
  :global(.adm .pthumb img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.adm .pthumb.ico) { color: var(--ink); background: var(--honey-soft); }
  :global(.adm .ptxt) { display: flex; flex-direction: column; min-width: 0; }
  :global(.adm .ptxt strong) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.adm .pmeta) { display: flex; gap: 8px; align-items: center; }
  :global(.adm .pprice) { font-weight: 700; font-size: 14px; white-space: nowrap; min-width: 70px; text-align: right; }
  :global(.adm .empty) { padding: 24px 0; }

  /* uređivanje */
  :global(.adm .ed-head) { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
  :global(.adm .editor > .h2) { margin-bottom: 16px; }
  :global(.adm .danger) { border: 2px dashed var(--line-strong); box-shadow: none; background: transparent; }

  /* fotografije */
  :global(.adm .imgs) { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; padding: 4px; border-radius: 16px; transition: background .2s; }
  :global(.adm .imgs.drop) { background: var(--honey-soft); outline: 2px dashed var(--ink); }
  :global(.adm .imc) { display: flex; flex-direction: column; gap: 8px; padding: 8px; border-radius: 16px; background: var(--surface-raised); }
  :global(.adm .imc-img) { position: relative; aspect-ratio: 1; border-radius: 10px; overflow: hidden; background: var(--line); }
  :global(.adm .imc-img img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.adm .imc-main) { position: absolute; top: 8px; left: 8px; }
  :global(.adm .imc .input) { min-height: 40px; font-size: 14px; padding: 0 10px; }
  :global(.adm .imc-acts) { display: flex; gap: 4px; justify-content: space-between; }
  :global(.adm .imc-add) { align-items: center; justify-content: center; text-align: center; min-height: 230px; border: 2px dashed var(--line-strong); cursor: pointer; font: inherit; color: var(--ink); }
  :global(.adm .imc-add:hover) { border-color: var(--ink); background: var(--honey-soft); }
  :global(.adm .imc-add:disabled) { cursor: progress; opacity: .7; }

  /* motivi */
  :global(.adm .mrow) { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 10px; align-items: center; }
  :global(.adm .mcena .input) { width: 96px; }
  :global(.adm .mthumb) { width: 64px; height: 64px; border-radius: 12px; border: 2px dashed var(--line-strong); background: var(--surface-paper); overflow: hidden; display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0; color: var(--ink-muted); }
  :global(.adm .mthumb:hover) { border-color: var(--ink); }
  :global(.adm .mthumb img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.adm .inl) { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 14px; }
  :global(.adm .inl .input) { width: 90px; }

  /* vrednosti opcije sa cenom */
  :global(.adm .vals) { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  :global(.adm .val) { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto auto auto; gap: 6px; align-items: center; }
  :global(.adm .val .inl .input) { width: 110px; }
  @media (max-width: 700px) { :global(.adm .val) { grid-template-columns: minmax(0, 1fr) auto; } }

  /* boje */
  :global(.adm .preview) { display: flex; flex-wrap: wrap; gap: 6px; min-height: 26px; }
  :global(.adm .pv) { width: 26px; height: 26px; border-radius: 50%; border: 2px solid rgba(49,32,24,.2); }
  :global(.adm .crow) { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 12px; align-items: center; transition: opacity .2s; }
  :global(.adm .crow.off) { opacity: .6; }
  :global(.adm .sw) { position: relative; width: 48px; height: 48px; border-radius: 50%; border: 2px solid rgba(49,32,24,.25); cursor: pointer; overflow: hidden; }
  :global(.adm .sw input) { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; cursor: pointer; }
  :global(.adm .nm) { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  :global(.adm .meta) { display: flex; gap: 8px; align-items: center; font-size: 12px; color: var(--ink-muted); }

  @media (max-width: 700px) {
    :global(.adm .card-box) { padding: 18px 14px; }
    :global(.adm .grid2), :global(.adm .pair) { grid-template-columns: minmax(0, 1fr); }
    :global(.adm .prow-main) { grid-template-columns: 48px minmax(0, 1fr); gap: 10px; }
    :global(.adm .pthumb) { width: 48px; height: 48px; }
    :global(.adm .pmeta) { grid-column: 2; flex-wrap: wrap; }
    :global(.adm .pprice) { text-align: left; min-width: 0; }
    :global(.adm .lst-row) { grid-template-columns: minmax(0, 1fr); }
    :global(.adm .lst-acts) { justify-content: flex-end; }
    :global(.adm .crow) { grid-template-columns: 44px minmax(0, 1fr); }
    :global(.adm .crow .tog) { grid-column: 2; }
    :global(.adm .imgs) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .save-bar { padding: 10px 14px; flex-wrap: wrap; gap: 8px; }
    .save-bar p { flex-basis: 100%; }
    .save-bar .btn { width: 100%; }
  }
</style>
